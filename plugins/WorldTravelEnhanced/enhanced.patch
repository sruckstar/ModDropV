+	// Enhanced: WorldTravelPatches can't switch the water to water_libertycity.xml there (switchWater has the
+	// Los Santos / Cayo Perico bounds compiled in), so Liberty City sits in the open ocean at full swell.
+	// Scale the deep-ocean waves down while in LC; [Enhanced] OceanWaveScale in WorldTravel.ini
+	// (0 = flat, 1 = game default), re-read every 2 s so it can be tuned in game.
+	bool oceanScaled = false;
+	float oceanWaveScale = 0.2f;
+	DWORD oceanIniReadAt = 0;
+
+	void EnhancedOceanCalm()
+	{
+		if (!worldtravel::gameversion::GetGameVersion())
+			return;
+		if (worldtravel::IsLibertyCity())
+		{
+			DWORD now = GetTickCount();
+			if (!oceanScaled || now - oceanIniReadAt > 2000)
+			{
+				char iniPath[MAX_PATH], buf[32];
+				GetFullPathNameA("WorldTravel.ini", MAX_PATH, iniPath, nullptr);
+				GetPrivateProfileStringA("Enhanced", "OceanWaveScale", "0.2", buf, sizeof(buf), iniPath);
+				oceanWaveScale = static_cast<float>(atof(buf));
+				oceanIniReadAt = now;
+			}
+			invoke<Void>(0xB96B00E976BE977F, oceanWaveScale); // SET_DEEP_OCEAN_SCALER
+			oceanScaled = true;
+		}
+		else if (oceanScaled && worldtravel::GetPlayerLocationID() != -1)
+		{
+			invoke<Void>(0x5E5E99285AE812DB); // RESET_DEEP_OCEAN_SCALER
+			oceanScaled = false;
+		}
+	}
+
