# The public repository holds the program (src, data, plugins, external, build files) and the README.
# Everything else — tests, tools, notes, promo media — stays local.

# --- build output / binaries ---
bin/
obj/
publish/
*.exe
*.dll
*.pdb
*.zip
*.7z
*.rar
*.rpf
*.nupkg

# ...except the mods-folder plugins and ASI loaders the app installs into the game folder
!data/plugins/
!data/plugins/**/
!data/plugins/**/*.asi
!data/plugins/**/*.dll
# ...and the script libraries whose licence lets ModDrop V ship them (data/dependencies.json says which)
!data/dependencies/
!data/dependencies/*/
!data/dependencies/*/*.dll

# --- tests, developer tools, research prototypes and sample third-party mods ---
tests/
tools/
prototypes/
mods_examples/
TestResults/
*.dev.slnx
plugins/LoadTrace/

# --- documents: developer notes, plans, store/video descriptions ---
CLAUDE.md
plans.md
docs/*
!docs/images/
*.txt
!LICENSE.txt
!**/LICENSE.txt
!**/*.LICENSE.txt

# --- media: only the screenshots the README shows are published ---
*.mp4
*.mp3
*.wav
*.ogg
docs/images/*
!docs/images/banner.png
!docs/images/01-drop-zone.png
!docs/images/02-vehicle.png
!docs/images/03-vehicle-3d.png
