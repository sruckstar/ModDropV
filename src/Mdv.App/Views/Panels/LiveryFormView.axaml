<!-- Livery panel, form slot: the vehicle it goes on, and each picture next to the vehicle texture it replaces. -->
<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Mdv.App.ViewModels"
             x:Class="Mdv.App.Views.Panels.LiveryFormView"
             x:DataType="vm:LiveryViewModel">
  <Border Classes="card" Padding="16,13,6,13">
    <Grid RowDefinitions="Auto,Auto,Auto,*" RowSpacing="10">
      <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="10" Margin="0,0,10,0">
        <TextBlock Classes="h" Text="LIVERY" />
        <TextBlock Grid.Column="1" Classes="desc" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"
                   Text="{Binding Name}" />
        <Border Grid.Column="2" Classes="badge">
          <TextBlock Text="livery" />
        </Border>
      </Grid>

      <!-- the vehicle: guessed, or typed / picked from the game's and the installed add-ons -->
      <StackPanel Grid.Row="1" Spacing="6" Margin="0,0,10,0">
        <Grid ColumnDefinitions="Auto,*" ColumnSpacing="12">
          <TextBlock Classes="kv-key" Text="Vehicle" VerticalAlignment="Center" />
          <AutoCompleteBox Grid.Column="1" ItemsSource="{Binding Vehicles}" SelectedItem="{Binding Vehicle}"
                           FilterMode="Contains" MinimumPrefixLength="1"
                           MaxDropDownHeight="260" FontFamily="{StaticResource MonoFont}" FontSize="12.5"
                           PlaceholderText="type a model name — police3, adder, an add-on's…"
                           ToolTip.Tip="The vehicle the livery goes on: a model of the game or an installed add-on" />
        </Grid>
        <TextBlock Classes="desc" Text="{Binding VehicleNote}" TextWrapping="Wrap" FontSize="11.5" />
        <StackPanel Orientation="Horizontal" Spacing="8" IsVisible="{Binding HasAlternatives}">
          <TextBlock Classes="desc" Text="Its textures fit" FontSize="11.5" VerticalAlignment="Center" />
          <ItemsControl ItemsSource="{Binding Alternatives}">
            <ItemsControl.ItemsPanel>
              <ItemsPanelTemplate>
                <WrapPanel ItemSpacing="6" LineSpacing="6" />
              </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
              <DataTemplate x:DataType="x:String">
                <Button Classes="chip" Content="{Binding}" FontFamily="{StaticResource MonoFont}" FontSize="11.5"
                        Command="{Binding $parent[UserControl].((vm:LiveryViewModel)DataContext).PickVehicleCommand}"
                        CommandParameter="{Binding}" ToolTip.Tip="Put the livery on this vehicle instead" />
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </StackPanel>
      </StackPanel>

      <StackPanel Grid.Row="2" Spacing="6" Margin="0,0,10,0">
        <TextBlock Classes="desc" Text="{Binding Status}" TextWrapping="Wrap" />
        <ProgressBar IsIndeterminate="True" IsVisible="{Binding IsResolving}" Height="3" MinHeight="3" />
      </StackPanel>

      <ScrollViewer Grid.Row="3" Padding="0,0,10,0">
        <StackPanel Spacing="10">
          <ItemsControl ItemsSource="{Binding Textures}" IsVisible="{Binding HasTextures}">
            <ItemsControl.ItemsPanel>
              <ItemsPanelTemplate>
                <StackPanel Spacing="6" />
              </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
              <DataTemplate x:DataType="vm:LiveryTextureRow">
                <Border Background="{DynamicResource Surface2Brush}" CornerRadius="8" Padding="10,8"
                        BorderBrush="{DynamicResource BorderBrushSoft}" BorderThickness="1">
                  <Grid ColumnDefinitions="Auto,Auto,Auto,*" ColumnSpacing="10">
                    <!-- the picture → the texture the game has now -->
                    <Border Width="58" Height="58" CornerRadius="6" ClipToBounds="True" VerticalAlignment="Top"
                            Background="{DynamicResource Surface3Brush}" ToolTip.Tip="The livery's picture">
                      <Image Source="{Binding Picture}" Stretch="Uniform" />
                    </Border>
                    <Path Grid.Column="1" Data="M5 12h12M13 7l5 5-5 5" Stroke="{DynamicResource Text3Brush}" StrokeThickness="1.8"
                          StrokeLineCap="Round" StrokeJoin="Round" Width="14" Height="14" Stretch="Uniform"
                          VerticalAlignment="Center" />
                    <Border Grid.Column="2" Width="58" Height="58" CornerRadius="6" ClipToBounds="True" VerticalAlignment="Top"
                            Background="{DynamicResource Surface3Brush}" BorderBrush="{DynamicResource BorderBrushSoft}"
                            BorderThickness="1" ToolTip.Tip="The vehicle's texture it replaces, as the game has it now">
                      <Panel>
                        <Image Source="{Binding Current}" Stretch="Uniform" />
                        <TextBlock Text="—" HorizontalAlignment="Center" VerticalAlignment="Center"
                                   Foreground="{DynamicResource Text3Brush}" IsVisible="{Binding !HasCurrent}" />
                      </Panel>
                    </Border>
                    <StackPanel Grid.Column="3" Spacing="5">
                      <Grid ColumnDefinitions="Auto,*" ColumnSpacing="10">
                        <TextBlock Text="{Binding Name}" FontWeight="SemiBold" FontSize="13" />
                        <TextBlock Grid.Column="1" Text="{Binding Origin}" FontSize="11" Foreground="{DynamicResource Text3Brush}"
                                   VerticalAlignment="Center" TextTrimming="CharacterEllipsis" ToolTip.Tip="{Binding Origin}" />
                      </Grid>
                      <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8" IsVisible="{Binding HasSlots}">
                        <ComboBox ItemsSource="{Binding Slots}" SelectedItem="{Binding SelectedSlot}" HorizontalAlignment="Stretch"
                                  PlaceholderText="pick the texture it replaces" MaxDropDownHeight="280"
                                  ToolTip.Tip="The vehicle's texture this picture takes the place of (liveries, signs, badges first)">
                          <ComboBox.ItemTemplate>
                            <DataTemplate x:DataType="x:String">
                              <TextBlock Text="{Binding}" FontFamily="{StaticResource MonoFont}" FontSize="11.5" />
                            </DataTemplate>
                          </ComboBox.ItemTemplate>
                        </ComboBox>
                        <TextBlock Grid.Column="1" Text="{Binding SlotInfo}" FontSize="10.5" FontFamily="{StaticResource MonoFont}"
                                   Foreground="{DynamicResource Text3Brush}" VerticalAlignment="Center" />
                      </Grid>
                      <TextBlock Text="No texture picked — this picture is skipped." FontSize="11.5" IsVisible="{Binding IsSkipped}"
                                 Foreground="{DynamicResource WarnBrush}" />
                      <TextBlock Text="{Binding Note}" FontSize="11.5" TextWrapping="Wrap" IsVisible="{Binding HasNote}"
                                 Foreground="{DynamicResource Text2Brush}" />
                    </StackPanel>
                  </Grid>
                </Border>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>

          <StackPanel Spacing="6" IsVisible="{Binding HasModels}">
            <TextBlock Classes="label" Text="MODKIT LIVERIES" Margin="0" />
            <ItemsControl ItemsSource="{Binding Models}">
              <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate>
                  <StackPanel Spacing="6" />
                </ItemsPanelTemplate>
              </ItemsControl.ItemsPanel>
              <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="vm:LiveryModelRow">
                  <Border Background="{DynamicResource Surface2Brush}" CornerRadius="8" Padding="12,8"
                          BorderBrush="{DynamicResource BorderBrushSoft}" BorderThickness="1">
                    <StackPanel Spacing="2">
                      <TextBlock Text="{Binding Name}" FontFamily="{StaticResource MonoFont}" FontSize="12.5" />
                      <TextBlock Text="{Binding Detail}" FontSize="11.5" TextWrapping="Wrap" IsVisible="{Binding IsOk}"
                                 Foreground="{DynamicResource Text3Brush}" />
                      <TextBlock Text="{Binding Detail}" FontSize="11.5" TextWrapping="Wrap" IsVisible="{Binding Problem}"
                                 Foreground="{DynamicResource WarnBrush}" />
                    </StackPanel>
                  </Border>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </StackPanel>
        </StackPanel>
      </ScrollViewer>
    </Grid>
  </Border>
</UserControl>
