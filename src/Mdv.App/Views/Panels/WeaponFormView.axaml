<!-- Weapon panel, form slot: how the weapon appears in the store, and its components' prices.
     The components card takes the rest of the column and scrolls inside. -->
<UserControl xmlns="https://github.com/avaloniaui"
        xmlns:l="using:Mdv.App.Localization"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Mdv.App.ViewModels"
             x:Class="Mdv.App.Views.Panels.WeaponFormView"
             x:DataType="vm:WeaponViewModel">
  <Grid RowDefinitions="Auto,*" RowSpacing="12">
    <!-- WEAPON -->
    <Border Classes="card">
      <StackPanel Spacing="10">
        <Grid ColumnDefinitions="Auto,Auto,*" ColumnSpacing="10">
          <Panel>
            <TextBlock Classes="idx" Text="02" IsVisible="{Binding Shell.IsPlayer}" />
            <TextBlock Classes="idx" Text="03" IsVisible="{Binding Shell.IsModder}" />
          </Panel>
          <TextBlock Grid.Column="1" Classes="h" Text="{l:Tr 'WEAPON'}" />
          <TextBlock Grid.Column="2" Classes="desc" VerticalAlignment="Center" TextWrapping="NoWrap"
                     TextTrimming="CharacterEllipsis" Text="{l:Tr 'How it appears in the in-game store'}" />
        </Grid>
        <Grid ColumnDefinitions="*,120,120" ColumnSpacing="10">
          <StackPanel>
            <TextBlock Classes="label" Text="{l:Tr 'NAME'}" />
            <TextBox Text="{Binding Name}" />
          </StackPanel>
          <StackPanel Grid.Column="1">
            <TextBlock Classes="label" Text="{l:Tr 'PRICE'}" />
            <TextBox Classes="num" Text="{Binding Price}" />
          </StackPanel>
          <StackPanel Grid.Column="2">
            <TextBlock Classes="label" Text="{l:Tr 'AMMO PRICE'}" />
            <TextBox Classes="num" Text="{Binding AmmoPrice}" />
          </StackPanel>
        </Grid>
        <Grid ColumnDefinitions="*,Auto">
          <StackPanel>
            <TextBlock Classes="label" Text="{l:Tr 'DESCRIPTION'}" />
            <TextBox Text="{Binding Description}" />
          </StackPanel>
          <StackPanel Grid.Column="1" Width="250" Margin="10,0,0,0" IsVisible="{Binding ModelNameVisible}"
                      ToolTip.Tip="{l:Tr 'Renames the .ydr/.ytd assets themselves. Magazines, attachments and hi-lods are re-derived from it. Leave empty to auto-generate.'}">
            <TextBlock Classes="label" Text="{l:Tr 'MODEL NAME'}" />
            <TextBox Classes="path" Text="{Binding ModelName}" PlaceholderText="{l:Tr 'auto — e.g. w_pi_mygun'}"
                     IsEnabled="{Binding ModelNameEnabled}" />
          </StackPanel>
          <!-- player: the shared pack (the modder's slot holds the model name) -->
          <CheckBox Grid.Column="1" Width="250" Margin="14,0,0,0" VerticalAlignment="Bottom" MinHeight="36"
                    IsChecked="{Binding MergePack}" IsVisible="{Binding MergePackVisible}"
                    ToolTip.Tip="{l:Tr 'Combine all guns into one DLC (otherwise a separate pack per gun). Spills into AddonWeapons2… past 3 GB.'}">
            <StackPanel Spacing="0">
              <TextBlock Text="{l:Tr 'Single «AddonWeapons» pack'}" FontWeight="SemiBold" FontSize="12.5" />
              <TextBlock Classes="desc" FontSize="11" Text="{l:Tr 'all guns in one DLC'}" />
            </StackPanel>
          </CheckBox>
        </Grid>
      </StackPanel>
    </Border>

    <!-- COMPONENTS -->
    <Border Grid.Row="1" Classes="card" MinHeight="100">
      <Grid RowDefinitions="Auto,*" RowSpacing="10">
        <Grid ColumnDefinitions="Auto,Auto,*,Auto" ColumnSpacing="10">
          <Panel>
            <TextBlock Classes="idx" Text="03" IsVisible="{Binding Shell.IsPlayer}" />
            <TextBlock Classes="idx" Text="04" IsVisible="{Binding Shell.IsModder}" />
          </Panel>
          <TextBlock Grid.Column="1" Classes="h" Text="{l:Tr 'COMPONENTS'}" />
          <TextBlock Grid.Column="2" Classes="desc" VerticalAlignment="Center" TextWrapping="NoWrap"
                     TextTrimming="CharacterEllipsis"
                     Text="{l:Tr 'Store price per module · empty = default (extended clip 400, attachments 500)'}" />
          <Border Grid.Column="3" Classes="badge" IsVisible="{Binding HasComponents}">
            <TextBlock Text="{Binding Components.Count}" />
          </Border>
        </Grid>
        <TextBlock Grid.Row="1" Classes="desc" IsVisible="{Binding !HasComponents}"
                   Text="{l:Tr 'Extended clips, scopes, suppressors and other attachments found in the source get their own price here.'}" />
        <ScrollViewer Grid.Row="1" IsVisible="{Binding HasComponents}" Padding="0,0,10,0">
          <ItemsControl ItemsSource="{Binding Components}" Margin="-3" VerticalAlignment="Top">
            <ItemsControl.ItemsPanel>
              <ItemsPanelTemplate>
                <UniformGrid Columns="2" />
              </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
              <DataTemplate x:DataType="vm:ComponentPriceViewModel">
                <Border Background="{DynamicResource Surface2Brush}" CornerRadius="8" Padding="10,5" Margin="3"
                        BorderBrush="{DynamicResource BorderBrushSoft}" BorderThickness="1">
                  <Grid ColumnDefinitions="Auto,*,100" ColumnSpacing="10">
                    <Border Classes="badge" VerticalAlignment="Center" MinWidth="56">
                      <TextBlock Text="{Binding Kind}" HorizontalAlignment="Center" />
                    </Border>
                    <TextBlock Grid.Column="1" Text="{Binding Label}" VerticalAlignment="Center"
                               TextTrimming="CharacterEllipsis" FontSize="12.5" ToolTip.Tip="{Binding Label}" />
                    <TextBox Grid.Column="2" Classes="num" Text="{Binding Price}" PlaceholderText="—"
                             MinHeight="30" Padding="8,4" />
                  </Grid>
                </Border>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </ScrollViewer>
      </Grid>
    </Border>
  </Grid>
</UserControl>
