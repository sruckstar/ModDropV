<!-- Replacement panel, form slot: each file of the mod and the place in the game it replaces. -->
<UserControl xmlns="https://github.com/avaloniaui"
        xmlns:l="using:Mdv.App.Localization"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Mdv.App.ViewModels"
             xmlns:mods="using:Mdv.Core.Mods"
             x:Class="Mdv.App.Views.Panels.ReplaceFormView"
             x:DataType="vm:ReplacementViewModel">
  <Border Classes="card" Padding="16,13,6,13">
    <Grid RowDefinitions="Auto,Auto,*" RowSpacing="10">
      <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="10" Margin="0,0,10,0">
        <TextBlock Classes="h" Text="{l:Tr 'WHERE THE FILES GO'}" />
        <TextBlock Grid.Column="1" Classes="desc" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"
                   Text="{Binding Name}" />
        <Border Grid.Column="2" Classes="badge">
          <TextBlock Text="{l:Tr 'replace'}" />
        </Border>
      </Grid>
      <StackPanel Grid.Row="1" Spacing="6" Margin="0,0,10,0">
        <TextBlock Classes="desc" Text="{Binding Status}" />
        <ProgressBar IsIndeterminate="True" IsVisible="{Binding IsResolving}" Height="3" MinHeight="3" />
      </StackPanel>
      <ScrollViewer Grid.Row="2" Padding="0,0,10,0">
        <ItemsControl ItemsSource="{Binding Files}">
          <ItemsControl.ItemsPanel>
            <ItemsPanelTemplate>
              <StackPanel Spacing="6" />
            </ItemsPanelTemplate>
          </ItemsControl.ItemsPanel>
          <ItemsControl.ItemTemplate>
            <DataTemplate x:DataType="vm:ReplaceFileRow">
              <Border Background="{DynamicResource Surface2Brush}" CornerRadius="8" Padding="12,8"
                      BorderBrush="{DynamicResource BorderBrushSoft}" BorderThickness="1">
                <StackPanel Spacing="6">
                  <Grid ColumnDefinitions="Auto,*" ColumnSpacing="10">
                    <TextBlock Text="{Binding Name}" FontWeight="SemiBold" FontSize="13" />
                    <TextBlock Grid.Column="1" Text="{Binding Origin}" FontSize="11" Foreground="{DynamicResource Text3Brush}"
                               VerticalAlignment="Center" TextTrimming="CharacterEllipsis" ToolTip.Tip="{Binding Origin}" />
                  </Grid>
                  <ComboBox ItemsSource="{Binding Candidates}" SelectedItem="{Binding SelectedTarget}" IsVisible="{Binding Found}"
                            IsEnabled="{Binding HasChoice}" HorizontalAlignment="Stretch"
                            ToolTip.Tip="{l:Tr 'The place in the game this file replaces (the copy the game loads comes first)'}">
                    <ComboBox.ItemTemplate>
                      <DataTemplate x:DataType="mods:ReplaceTarget">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                          <TextBlock Text="{Binding GamePath}" FontFamily="{StaticResource MonoFont}" FontSize="11.5"
                                     TextTrimming="CharacterEllipsis" />
                          <TextBlock Text="{Binding Where}" FontSize="11" Foreground="{DynamicResource Text3Brush}" />
                        </StackPanel>
                      </DataTemplate>
                    </ComboBox.ItemTemplate>
                  </ComboBox>
                  <TextBlock Text="{l:Tr 'Not a file of this game — it is skipped.'}" FontSize="11.5" IsVisible="{Binding Missing}"
                             Foreground="{DynamicResource DangerBrush}" />
                  <TextBlock Text="{Binding Note}" FontSize="11.5" TextWrapping="Wrap" IsVisible="{Binding HasNote}"
                             Foreground="{DynamicResource WarnBrush}" />
                </StackPanel>
              </Border>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
      </ScrollViewer>
    </Grid>
  </Border>
</UserControl>
