<!-- Clothing panel, form slot: Add-On or Replace; the collections, the ped loose models are packed for and the dlcpacks
     folder — or whose clothes they replace, "as new clothes", and where each file goes. -->
<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Mdv.App.ViewModels"
             xmlns:mods="using:Mdv.Core.Mods"
             x:Class="Mdv.App.Views.Panels.ClothingFormView"
             x:DataType="vm:ClothingViewModel">
  <Border Classes="card" Padding="16,13,6,13">
    <Grid RowDefinitions="Auto,Auto,Auto,Auto,*,Auto" RowSpacing="10">
      <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="10" Margin="0,0,10,0">
        <TextBlock Classes="h" Text="CLOTHING" />
        <TextBlock Grid.Column="1" Classes="desc" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"
                   Text="{Binding Name}" />
        <Border Grid.Column="2" Classes="badge">
          <TextBlock Text="clothing" />
        </Border>
      </Grid>
      <TextBlock Grid.Row="1" Classes="desc" Text="{Binding SourceText}" TextWrapping="Wrap" Margin="0,0,10,0" />

      <StackPanel Grid.Row="2" Spacing="6" Margin="0,0,10,0" IsVisible="{Binding ShowInstallAs}">
        <TextBlock Classes="label" Text="INSTALL AS" Margin="0" />
        <RadioButton Classes="found" GroupName="clothing-as" IsChecked="{Binding InstallAsAddon}" IsEnabled="{Binding CanAddon}"
                     ToolTip.Tip="The story characters can't have add-on collections — their clothes are replaced or added as new slots">
          <Grid ColumnDefinitions="Auto,*" ColumnSpacing="11">
            <Panel Width="16" Height="16" VerticalAlignment="Center">
              <Ellipse Classes="radio-ring" StrokeThickness="1.5" />
              <Ellipse Classes="radio-dot" Width="8" Height="8" />
            </Panel>
            <TextBlock Grid.Column="1" Text="{Binding AddonText}" FontSize="12.5" TextWrapping="Wrap" VerticalAlignment="Center" />
          </Grid>
        </RadioButton>
        <RadioButton Classes="found" GroupName="clothing-as" IsChecked="{Binding InstallAsReplace}">
          <Grid ColumnDefinitions="Auto,*" ColumnSpacing="11">
            <Panel Width="16" Height="16" VerticalAlignment="Center">
              <Ellipse Classes="radio-ring" StrokeThickness="1.5" />
              <Ellipse Classes="radio-dot" Width="8" Height="8" />
            </Panel>
            <TextBlock Grid.Column="1" Text="{Binding ReplaceText}" FontSize="12.5" TextWrapping="Wrap" VerticalAlignment="Center" />
          </Grid>
        </RadioButton>
      </StackPanel>

      <!-- add-on: loose models become a collection of the MP male or female -->
      <StackPanel Grid.Row="3" Spacing="6" Margin="0,0,10,0" IsVisible="{Binding ShowAddon}">
        <StackPanel Spacing="6" IsVisible="{Binding HasLoose}">
          <TextBlock Classes="label" Text="NEW CLOTHES FOR" Margin="0" />
          <Grid ColumnDefinitions="*,*" ColumnSpacing="8">
            <RadioButton Classes="found" GroupName="clothing-gender" IsChecked="{Binding LooseIsMale}">
              <Grid ColumnDefinitions="Auto,*" ColumnSpacing="11">
                <Panel Width="16" Height="16" VerticalAlignment="Center">
                  <Ellipse Classes="radio-ring" StrokeThickness="1.5" />
                  <Ellipse Classes="radio-dot" Width="8" Height="8" />
                </Panel>
                <TextBlock Grid.Column="1" Text="MP male (mp_m_freemode_01)" FontSize="12.5" TextWrapping="Wrap" VerticalAlignment="Center" />
              </Grid>
            </RadioButton>
            <RadioButton Grid.Column="1" Classes="found" GroupName="clothing-gender" IsChecked="{Binding LooseIsFemale}">
              <Grid ColumnDefinitions="Auto,*" ColumnSpacing="11">
                <Panel Width="16" Height="16" VerticalAlignment="Center">
                  <Ellipse Classes="radio-ring" StrokeThickness="1.5" />
                  <Ellipse Classes="radio-dot" Width="8" Height="8" />
                </Panel>
                <TextBlock Grid.Column="1" Text="MP female (mp_f_freemode_01)" FontSize="12.5" TextWrapping="Wrap" VerticalAlignment="Center" />
              </Grid>
            </RadioButton>
          </Grid>
        </StackPanel>
      </StackPanel>

      <ScrollViewer Grid.Row="4" Padding="0,0,10,0" IsVisible="{Binding ShowAddon}">
        <ItemsControl ItemsSource="{Binding Items}">
          <ItemsControl.ItemsPanel>
            <ItemsPanelTemplate>
              <StackPanel Spacing="6" />
            </ItemsPanelTemplate>
          </ItemsControl.ItemsPanel>
          <ItemsControl.ItemTemplate>
            <DataTemplate x:DataType="vm:AddonItemRow">
              <Border Background="{DynamicResource Surface2Brush}" CornerRadius="8" Padding="12,8"
                      BorderBrush="{DynamicResource BorderBrushSoft}" BorderThickness="1">
                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
                  <StackPanel Spacing="2">
                    <TextBlock Text="{Binding Title}" FontWeight="SemiBold" FontSize="13.5" TextTrimming="CharacterEllipsis" />
                    <TextBlock Text="{Binding Detail}" FontSize="11.5" Foreground="{DynamicResource Text3Brush}"
                               IsVisible="{Binding HasDetail}" TextTrimming="CharacterEllipsis" />
                  </StackPanel>
                  <StackPanel Grid.Column="1" Spacing="1" VerticalAlignment="Center" HorizontalAlignment="Right">
                    <TextBlock Text="collection" FontSize="10" HorizontalAlignment="Right" Foreground="{DynamicResource Text3Brush}" />
                    <SelectableTextBlock Text="{Binding Spawn}" FontFamily="{StaticResource MonoFont}" FontSize="12"
                                         Foreground="{DynamicResource AccentBrush}" HorizontalAlignment="Right" />
                  </StackPanel>
                </Grid>
              </Border>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
      </ScrollViewer>

      <ScrollViewer Grid.Row="3" Grid.RowSpan="2" Padding="0,0,10,0" IsVisible="{Binding InstallAsReplace}">
        <StackPanel Spacing="6">
          <Grid ColumnDefinitions="Auto,*" ColumnSpacing="12">
            <TextBlock Classes="kv-key" Text="Worn by" VerticalAlignment="Center" />
            <ComboBox Grid.Column="1" ItemsSource="{Binding Wearers}" SelectedItem="{Binding SelectedWearer}" HorizontalAlignment="Stretch"
                      MaxDropDownHeight="360"
                      ToolTip.Tip="Whose clothes the files replace: a story character, an MP ped's own set or one of its collections" />
          </Grid>
          <CheckBox IsChecked="{Binding AsNew}"
                    ToolTip.Tip="Each model gets a new slot in the ped's ymt (its files are renamed to the new number) — the ped's own clothes stay">
            <TextBlock Text="Add them as new clothes (new slots) — keep the ped's own" FontSize="12.5" TextWrapping="Wrap" />
          </CheckBox>
          <TextBlock Classes="desc" Text="{Binding ReplaceStatus}" TextWrapping="Wrap" />
          <ProgressBar IsIndeterminate="True" IsVisible="{Binding IsResolving}" Height="3" MinHeight="3" />
          <ItemsControl ItemsSource="{Binding Files}">
          <ItemsControl.ItemsPanel>
            <ItemsPanelTemplate>
              <StackPanel Spacing="6" />
            </ItemsPanelTemplate>
          </ItemsControl.ItemsPanel>
          <ItemsControl.ItemTemplate>
            <DataTemplate x:DataType="vm:ReplaceFileRow">
              <Border Background="{DynamicResource Surface2Brush}" CornerRadius="8" Padding="12,8"
                      BorderBrush="{DynamicResource BorderBrushSoft}" BorderThickness="1">
                <StackPanel Spacing="6">
                  <Grid ColumnDefinitions="Auto,*" ColumnSpacing="10">
                    <TextBlock Text="{Binding Name}" FontWeight="SemiBold" FontSize="13" />
                    <TextBlock Grid.Column="1" Text="{Binding Origin}" FontSize="11" Foreground="{DynamicResource Text3Brush}"
                               VerticalAlignment="Center" TextTrimming="CharacterEllipsis" ToolTip.Tip="{Binding Origin}" />
                  </Grid>
                  <ComboBox ItemsSource="{Binding Candidates}" SelectedItem="{Binding SelectedTarget}" IsVisible="{Binding Found}"
                            IsEnabled="{Binding HasChoice}" HorizontalAlignment="Stretch">
                    <ComboBox.ItemTemplate>
                      <DataTemplate x:DataType="mods:ReplaceTarget">
                        <Grid ColumnDefinitions="Auto,*" ColumnSpacing="8" ToolTip.Tip="{Binding GamePath}">
                          <TextBlock Text="{Binding Where}" FontSize="11.5" Foreground="{DynamicResource AccentBrush}" VerticalAlignment="Center" />
                          <TextBlock Grid.Column="1" Text="{Binding GamePath}" FontFamily="{StaticResource MonoFont}" FontSize="11"
                                     Foreground="{DynamicResource Text3Brush}" TextTrimming="LeadingCharacterEllipsis" VerticalAlignment="Center" />
                        </Grid>
                      </DataTemplate>
                    </ComboBox.ItemTemplate>
                  </ComboBox>
                  <TextBlock Text="Not one of this ped's files, and no slot for it — it is skipped." FontSize="11.5"
                             IsVisible="{Binding Missing}" Foreground="{DynamicResource DangerBrush}" TextWrapping="Wrap" />
                  <TextBlock Text="{Binding Note}" FontSize="11.5" TextWrapping="Wrap" IsVisible="{Binding HasNote}"
                             Foreground="{DynamicResource WarnBrush}" />
                </StackPanel>
              </Border>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
          </ItemsControl>
        </StackPanel>
      </ScrollViewer>

      <StackPanel Grid.Row="5" Spacing="5" Margin="0,0,10,0" IsVisible="{Binding ShowAddon}">
        <Grid ColumnDefinitions="Auto,*" ColumnSpacing="12">
          <TextBlock Classes="kv-key" Text="Pack folder" VerticalAlignment="Center" />
          <TextBox Grid.Column="1" Classes="path" Text="{Binding PackName}" MaxLength="32"
                   ToolTip.Tip="The folder under mods\update\x64\dlcpacks — latin letters, digits and _ only" />
        </Grid>
        <TextBlock Text="{Binding PackDetail}" FontSize="10.5" FontFamily="{StaticResource MonoFont}"
                   Foreground="{DynamicResource Text3Brush}" TextWrapping="Wrap" />
      </StackPanel>
    </Grid>
  </Border>
</UserControl>
