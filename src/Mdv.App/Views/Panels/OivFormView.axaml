<!-- OIV panel, form slot: the package's own card — its colours, icon, name, author and description. -->
<UserControl xmlns="https://github.com/avaloniaui"
        xmlns:l="using:Mdv.App.Localization"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Mdv.App.ViewModels"
             x:Class="Mdv.App.Views.Panels.OivFormView"
             x:DataType="vm:OivViewModel">
  <Border Classes="card" Padding="0" ClipToBounds="True">
    <Grid RowDefinitions="Auto,*">
      <!-- header band in the package's colour (the accent wash when it has none) -->
      <Panel>
        <Border Background="{DynamicResource AccentWashBrush}" CornerRadius="10,10,0,0" />
        <Border Background="{Binding HeaderBrush}" CornerRadius="10,10,0,0" IsVisible="{Binding HasHeaderColor}" />
        <Border CornerRadius="10,10,0,0" Padding="18,16">
          <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="14">
            <Border Width="56" Height="56" CornerRadius="10" ClipToBounds="True" VerticalAlignment="Center"
                    Background="{DynamicResource Surface2Brush}" BorderBrush="{DynamicResource BorderBrushSoft}" BorderThickness="1">
              <Panel>
                <Image Source="{Binding Icon}" Stretch="UniformToFill" IsVisible="{Binding HasIcon}" />
                <Path Data="{StaticResource IconArchive}" Stroke="{DynamicResource AccentBrush}" StrokeThickness="1.7"
                      StrokeLineCap="Round" StrokeJoin="Round" Stretch="Uniform" Width="24" Height="24"
                      IsVisible="{Binding !HasIcon}" />
              </Panel>
            </Border>
            <!-- the package's own text colour on its own header, the theme's otherwise -->
            <StackPanel Grid.Column="1" Spacing="3" VerticalAlignment="Center" IsVisible="{Binding !HasHeaderColor}">
              <TextBlock Text="{Binding Name}" FontFamily="{StaticResource DisplayFont}" FontSize="20" FontWeight="SemiBold"
                         LetterSpacing="0.4" TextTrimming="CharacterEllipsis" />
              <TextBlock Text="{Binding Byline}" FontSize="12" Foreground="{DynamicResource Text2Brush}" TextTrimming="CharacterEllipsis" />
            </StackPanel>
            <StackPanel Grid.Column="1" Spacing="3" VerticalAlignment="Center" IsVisible="{Binding HasHeaderColor}">
              <TextBlock Text="{Binding Name}" FontFamily="{StaticResource DisplayFont}" FontSize="20" FontWeight="SemiBold"
                         LetterSpacing="0.4" TextTrimming="CharacterEllipsis" Foreground="{Binding HeaderText}" />
              <TextBlock Text="{Binding Byline}" FontSize="12" Opacity="0.8" TextTrimming="CharacterEllipsis"
                         Foreground="{Binding HeaderText}" />
            </StackPanel>
            <Border Grid.Column="2" Classes="badge" VerticalAlignment="Top">
              <TextBlock Text="{Binding Badge}" />
            </Border>
          </Grid>
        </Border>
      </Panel>

      <ScrollViewer Grid.Row="1" Padding="18,14,18,16">
        <StackPanel Spacing="12">
          <!-- World Travel (Liberty City Preservation Project): which map it runs with -->
          <StackPanel Spacing="6" IsVisible="{Binding HasWorldTravel}">
            <TextBlock Classes="label" Text="{l:Tr 'WORLD TRAVEL MAP'}" Margin="0" />
            <RadioButton Classes="found" GroupName="wt-map" IsChecked="{Binding WorldTravelStoryMode}">
              <Grid ColumnDefinitions="Auto,*" ColumnSpacing="11">
                <Panel Width="16" Height="16" VerticalAlignment="Center">
                  <Ellipse Classes="radio-ring" StrokeThickness="1.5" />
                  <Ellipse Classes="radio-dot" Width="8" Height="8" />
                </Panel>
                <TextBlock Grid.Column="1" FontSize="12.5" TextWrapping="Wrap" VerticalAlignment="Center"
                           Text="{l:Tr 'Story mode map — what the game loads by itself'}" />
              </Grid>
            </RadioButton>
            <RadioButton Classes="found" GroupName="wt-map" IsChecked="{Binding WorldTravelOnline}">
              <Grid ColumnDefinitions="Auto,*" ColumnSpacing="11">
                <Panel Width="16" Height="16" VerticalAlignment="Center">
                  <Ellipse Classes="radio-ring" StrokeThickness="1.5" />
                  <Ellipse Classes="radio-dot" Width="8" Height="8" />
                </Panel>
                <TextBlock Grid.Column="1" FontSize="12.5" TextWrapping="Wrap" VerticalAlignment="Center"
                           Text="{l:Tr 'Online map — the game loads it in story mode too, no MP map loader needed'}" />
              </Grid>
            </RadioButton>
            <TextBlock Classes="desc" TextWrapping="Wrap"
                       Text="{l:Tr 'On the way to Liberty City, World Travel unloads Los Santos by the lists of the map you pick here. Map files of game updates newer than the mod are added to its Los Santos list.'}" />
          </StackPanel>
          <SelectableTextBlock Text="{Binding Description}" TextWrapping="Wrap" FontSize="13" LineHeight="20"
                               Foreground="{DynamicResource Text2Brush}" IsVisible="{Binding HasDescription}" />
          <TextBlock Classes="desc" Text="{l:Tr 'The package has no description.'}" IsVisible="{Binding !HasDescription}" />
          <Button Classes="ghost small" HorizontalAlignment="Left" Command="{Binding OpenLinkCommand}"
                  IsVisible="{Binding HasLink}" ToolTip.Tip="{Binding Link}">
            <StackPanel Orientation="Horizontal" Spacing="7">
              <Path Data="{StaticResource IconExpand}" Stroke="{Binding $parent[Button].Foreground}" StrokeThickness="1.7"
                    StrokeLineCap="Round" StrokeJoin="Round" Stretch="Uniform" Width="11" Height="11" />
              <TextBlock Text="{l:Tr 'Author’s page'}" />
            </StackPanel>
          </Button>
          <Border Classes="note">
            <TextBlock TextWrapping="Wrap" FontSize="12" Foreground="{DynamicResource Text2Brush}"
                       Text="{l:Tr 'Installed the safe way: files inside game archives go into copies under mods, the game’s own archives stay untouched. Removing the package in the Library puts everything back.'}" />
          </Border>
        </StackPanel>
      </ScrollViewer>
    </Grid>
  </Border>
</UserControl>
