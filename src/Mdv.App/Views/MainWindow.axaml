<Window xmlns="https://github.com/avaloniaui"
        xmlns:l="using:Mdv.App.Localization"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="using:Mdv.App.ViewModels"
        xmlns:c="using:Mdv.App.Controls"
        xmlns:p="using:Mdv.App.Views.Panels"
        mc:Ignorable="d" d:DesignWidth="1120" d:DesignHeight="780"
        x:Class="Mdv.App.Views.MainWindow"
        x:DataType="vm:MainViewModel"
        Title="ModDrop V"
        Icon="/Assets/moddropv.ico"
        Width="1120" Height="780" MinWidth="980" MinHeight="720"
        WindowStartupLocation="CenterScreen"
        DragDrop.AllowDrop="True">

  <Grid>
    <Grid RowDefinitions="Auto,Auto,*,Auto">

      <!-- ================= HEADER ================= -->
      <Border Grid.Row="0" Padding="20,10" BorderBrush="{DynamicResource BorderBrushSoft}" BorderThickness="0,0,0,1">
        <Grid ColumnDefinitions="Auto,*,Auto,Auto,Auto,Auto,Auto" ColumnSpacing="10">
          <StackPanel Orientation="Horizontal" Spacing="12" VerticalAlignment="Center">
            <c:DropMark Width="34" Height="34" />
            <StackPanel VerticalAlignment="Center" Spacing="1">
              <TextBlock Classes="brand" Text="MODDROP V" />
              <TextBlock Classes="brand-sub" Text="{l:Tr 'INSTALL · BUILD'}" />
            </StackPanel>
          </StackPanel>

          <!-- player: the game mods are installed into; opens the game dialog -->
          <Button Grid.Column="2" Classes="chip" Classes.missing="{Binding !HasGame}" VerticalAlignment="Center"
                  IsVisible="{Binding IsPlayer}" Command="{Binding OpenGameDialogCommand}"
                  ToolTip.Tip="{l:Tr 'The GTA V mods are installed into — click to change'}">
            <Grid ColumnDefinitions="Auto,Auto,Auto" ColumnSpacing="10">
              <Path Data="{StaticResource IconGame}" Stroke="{DynamicResource AccentBrush}" StrokeThickness="1.6"
                    StrokeLineCap="Round" StrokeJoin="Round" Stretch="Uniform" Width="22" Height="16"
                    VerticalAlignment="Center" />
              <StackPanel Grid.Column="1" VerticalAlignment="Center">
                <TextBlock Text="{Binding GameChipTitle}" FontWeight="SemiBold" FontSize="12.5" />
                <TextBlock Text="{Binding GameChipDetail}" FontSize="10.5" MaxWidth="250"
                           FontFamily="{StaticResource MonoFont}" Foreground="{DynamicResource Text3Brush}"
                           TextTrimming="LeadingCharacterEllipsis" />
              </StackPanel>
              <TextBlock Grid.Column="2" Text="{l:Tr 'Change'}" FontSize="11" VerticalAlignment="Center"
                         Foreground="{DynamicResource AccentBrush}" />
            </Grid>
          </Button>

          <Border Grid.Column="3" Classes="seg" VerticalAlignment="Center">
            <StackPanel Orientation="Horizontal" Spacing="2">
              <RadioButton Classes="seg" GroupName="mode" IsChecked="{Binding IsModder}"
                           ToolTip.Tip="{l:Tr 'Build add-ons into a folder'}">
                <StackPanel Spacing="0">
                  <TextBlock Text="{l:Tr 'For Modders'}" FontWeight="SemiBold" HorizontalAlignment="Center" />
                  <TextBlock Text="{l:Tr 'build DLC to a folder'}" FontSize="10" Opacity="0.7" HorizontalAlignment="Center" />
                </StackPanel>
              </RadioButton>
              <RadioButton Classes="seg" GroupName="mode" IsChecked="{Binding IsPlayer}"
                           ToolTip.Tip="{l:Tr 'Install mods straight into GTA V'}">
                <StackPanel Spacing="0">
                  <TextBlock Text="{l:Tr 'For Players'}" FontWeight="SemiBold" HorizontalAlignment="Center" />
                  <TextBlock Text="{l:Tr 'install into GTA V'}" FontSize="10" Opacity="0.7" HorizontalAlignment="Center" />
                </StackPanel>
              </RadioButton>
            </StackPanel>
          </Border>

          <Button Grid.Column="4" Classes="ghost small" VerticalAlignment="Center" MinHeight="34"
                  Command="{Binding OpenLogCommand}" ToolTip.Tip="{l:Tr 'Build / install log'}">
            <StackPanel Orientation="Horizontal" Spacing="7">
              <Path Data="{StaticResource IconLog}" Stroke="{Binding $parent[Button].Foreground}" StrokeThickness="1.7"
                    StrokeLineCap="Round" Stretch="Uniform" Width="13" Height="12" VerticalAlignment="Center" />
              <TextBlock Text="{l:Tr 'Log'}" VerticalAlignment="Center" />
              <Panel VerticalAlignment="Center" IsVisible="{Binding HasLog}">
                <Ellipse Width="7" Height="7" Fill="{DynamicResource AccentBrush}" />
                <Ellipse Width="7" Height="7" Fill="{DynamicResource DangerBrush}" IsVisible="{Binding LogIsError}" />
              </Panel>
            </StackPanel>
          </Button>

          <!-- interface language: the menu rebuilds the window in the one picked -->
          <Button x:Name="LangButton" Grid.Column="5" Classes="ghost small" VerticalAlignment="Center" MinHeight="34"
                  ToolTip.Tip="{l:Tr 'Interface language'}">
            <StackPanel Orientation="Horizontal" Spacing="6">
              <Path Data="{StaticResource IconGlobe}" Stroke="{Binding $parent[Button].Foreground}" StrokeThickness="1.6"
                    Stretch="Uniform" Width="14" Height="14" VerticalAlignment="Center" />
              <TextBlock Text="{Binding LanguageShort}" VerticalAlignment="Center" FontWeight="SemiBold" />
            </StackPanel>
            <Button.Flyout>
              <Flyout Placement="BottomEdgeAlignedRight">
                <ItemsControl ItemsSource="{Binding Languages}" MinWidth="200">
                  <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="vm:LanguageOption">
                      <Button Classes="ghost small" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch"
                              BorderThickness="0"
                              Command="{Binding #LangButton.((vm:MainViewModel)DataContext).SetLanguageCommand}"
                              CommandParameter="{Binding Code}">
                        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
                          <TextBlock Text="{Binding NativeName}" VerticalAlignment="Center" />
                          <Path Grid.Column="1" Data="{StaticResource IconCheck}" Stroke="{DynamicResource AccentBrush}"
                                StrokeThickness="2" Stretch="Uniform" Width="11" Height="9" VerticalAlignment="Center"
                                IsVisible="{Binding IsCurrent}" />
                        </Grid>
                      </Button>
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>
              </Flyout>
            </Button.Flyout>
          </Button>

          <Button Grid.Column="6" Classes="icon" Command="{Binding ToggleThemeCommand}"
                  ToolTip.Tip="{l:Tr 'Toggle light / dark theme'}" VerticalAlignment="Center">
            <Panel Width="20" Height="20">
              <PathIcon Data="{StaticResource IconSun}" Width="18" Height="18" IsVisible="{Binding IsDark}" />
              <PathIcon Data="{StaticResource IconMoon}" Width="16" Height="16" IsVisible="{Binding !IsDark}" />
            </Panel>
          </Button>
        </Grid>
      </Border>

      <!-- ================= PAGE BAR: the player's pages / the modder's add-on types ================= -->
      <Border Grid.Row="1" Padding="20,0" BorderBrush="{DynamicResource BorderBrushSoft}" BorderThickness="0,0,0,1"
              Background="{DynamicResource Surface1Brush}">
        <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="12">
          <StackPanel Orientation="Horizontal" Spacing="6" IsVisible="{Binding IsPlayer}">
            <RadioButton Classes="tab" GroupName="page" IsChecked="{Binding IsInstallPage}">
              <StackPanel Orientation="Horizontal" Spacing="8">
                <Path Data="{StaticResource IconDrop}" Stroke="{Binding $parent[RadioButton].Foreground}" StrokeThickness="1.8"
                      StrokeLineCap="Round" StrokeJoin="Round" Stretch="Uniform" Width="13" Height="13" />
                <TextBlock Text="{l:Tr 'Install'}" />
              </StackPanel>
            </RadioButton>
            <RadioButton Classes="tab" GroupName="page" IsChecked="{Binding IsLibraryPage}"
                         ToolTip.Tip="{l:Tr 'What ModDrop V installed into this game'}">
              <StackPanel Orientation="Horizontal" Spacing="8">
                <Path Data="{StaticResource IconLayers}" Stroke="{Binding $parent[RadioButton].Foreground}" StrokeThickness="1.7"
                      StrokeLineCap="Round" StrokeJoin="Round" Stretch="Uniform" Width="13" Height="13" />
                <TextBlock Text="{l:Tr 'Library'}" />
                <Border Classes="count" IsVisible="{Binding HasInstalled}">
                  <TextBlock Text="{Binding InstalledCount}" />
                </Border>
                <Ellipse Width="7" Height="7" Fill="{DynamicResource AccentBrush}" VerticalAlignment="Center"
                         IsVisible="{Binding HasPendingChanges}" ToolTip.Tip="{l:Tr 'Changes waiting to be applied'}" />
              </StackPanel>
            </RadioButton>
          </StackPanel>

          <ItemsControl ItemsSource="{Binding ModderTypes}" IsVisible="{Binding IsModder}">
            <ItemsControl.ItemsPanel>
              <ItemsPanelTemplate>
                <StackPanel Orientation="Horizontal" Spacing="6" />
              </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
              <DataTemplate x:DataType="vm:AddonTypeViewModel">
                <RadioButton Classes="tab" GroupName="addon" IsChecked="{Binding IsSelected}">
                  <StackPanel Orientation="Horizontal" Spacing="7">
                    <TextBlock Text="{Binding Label}" />
                    <Border Classes="count soon" IsVisible="{Binding Soon}">
                      <TextBlock Text="{l:Tr 'soon'}" />
                    </Border>
                  </StackPanel>
                </RadioButton>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>

          <!-- modder: the game build every add-on type is packed for -->
          <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="10" VerticalAlignment="Center" IsVisible="{Binding IsModder}">
            <TextBlock Classes="desc" Text="{l:Tr 'Game version'}" VerticalAlignment="Center" />
            <Border Classes="seg small">
              <StackPanel Orientation="Horizontal" Spacing="2">
                <RadioButton Classes="seg" GroupName="edition" IsChecked="{Binding IsLegacy}" Content="Legacy"
                             ToolTip.Tip="{l:Tr 'GTA V Legacy (GTA5.exe)'}" />
                <RadioButton Classes="seg" GroupName="edition" IsChecked="{Binding IsEnhanced}" Content="Enhanced"
                             ToolTip.Tip="{l:Tr 'GTA V Enhanced (GTA5_Enhanced.exe): models are converted to gen9'}" />
              </StackPanel>
            </Border>
          </StackPanel>

          <!-- player: how the game stands; opens the library, where the full status is -->
          <Button Grid.Column="2" Classes="pill" Classes.warn="{Binding StatusHasWarnings}" VerticalAlignment="Center"
                  IsVisible="{Binding HasStatus}" Command="{Binding ShowLibraryCommand}"
                  ToolTip.Tip="{l:Tr 'Game status — mods folder, loaders, ScriptHookV, DLC packs'}">
            <StackPanel Orientation="Horizontal" Spacing="8">
              <Panel Width="8" Height="8" VerticalAlignment="Center">
                <Ellipse Fill="{DynamicResource SuccessBrush}" IsVisible="{Binding !StatusHasWarnings}" />
                <Ellipse Fill="{DynamicResource WarnBrush}" IsVisible="{Binding StatusHasWarnings}" />
              </Panel>
              <TextBlock Text="{Binding StatusSummary}" VerticalAlignment="Center" />
            </StackPanel>
          </Button>
        </Grid>
      </Border>

      <!-- ================= WORKSPACE: source + settings | analysis (modder, player's install page) ================= -->
      <Grid Grid.Row="2" ColumnDefinitions="*,360" ColumnSpacing="14" Margin="20,12" IsVisible="{Binding ShowWorkspace}">

        <DockPanel Grid.Column="0">
          <StackPanel DockPanel.Dock="Top" Spacing="12" Margin="0,0,0,12" IsVisible="{Binding ShowTopCards}">

            <!-- player: 01 SOURCE — the drop, and what was found in it -->
            <Border Classes="card" IsVisible="{Binding IsPlayer}">
              <StackPanel Spacing="10">
                <Grid ColumnDefinitions="Auto,Auto,*" ColumnSpacing="10">
                  <TextBlock Classes="idx" Text="01" />
                  <TextBlock Grid.Column="1" Classes="h" Text="{l:Tr 'SOURCE'}" />
                  <TextBlock Grid.Column="2" Classes="desc" VerticalAlignment="Center" TextWrapping="NoWrap"
                             TextTrimming="CharacterEllipsis" Text="{l:Tr 'The mod as you downloaded it — a folder or an archive'}" />
                </Grid>

                <!-- the whole window accepts the drop, this is where it shows -->
                <Panel x:Name="DropZone" Classes="dropzone" MinHeight="72">
                  <Rectangle Classes="dropframe" RadiusX="10" RadiusY="10" StrokeThickness="1.5" StrokeDashArray="5,4" />

                  <!-- empty -->
                  <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="16" Margin="20,12"
                        IsVisible="{Binding DropZoneEmpty}" VerticalAlignment="Center">
                    <Path Data="{StaticResource IconDrop}" Stroke="{DynamicResource AccentBrush}" StrokeThickness="1.8"
                          StrokeLineCap="Round" StrokeJoin="Round" Stretch="Uniform" Width="28" Height="28"
                          VerticalAlignment="Center" />
                    <StackPanel Grid.Column="1" Spacing="3" VerticalAlignment="Center">
                      <TextBlock Text="{l:Tr 'Drop a mod here'}" FontWeight="SemiBold" FontSize="15"
                                 FontFamily="{StaticResource DisplayFont}" LetterSpacing="0.6" />
                      <TextBlock Classes="desc"
                                 Text="{l:Tr 'Folder, .zip, .rar, .7z or .oiv — ModDrop V looks inside, tells you what it is and shows every step before installing.'}" />
                    </StackPanel>
                    <StackPanel Grid.Column="2" Spacing="6" VerticalAlignment="Center">
                      <Button Classes="ghost small" HorizontalAlignment="Stretch" Command="{Binding BrowseSourceFolderCommand}">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                          <PathIcon Data="{StaticResource IconFolder}" Width="12" Height="12" />
                          <TextBlock Text="{l:Tr 'Choose folder…'}" />
                        </StackPanel>
                      </Button>
                      <Button Classes="ghost small" HorizontalAlignment="Stretch" Command="{Binding BrowseSourceArchiveCommand}">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                          <Path Data="{StaticResource IconArchive}" Stroke="{Binding $parent[Button].Foreground}"
                                StrokeThickness="1.6" StrokeJoin="Round" Stretch="Uniform" Width="12" Height="12" />
                          <TextBlock Text="{l:Tr 'Choose archive…'}" />
                        </StackPanel>
                      </Button>
                    </StackPanel>
                  </Grid>

                  <!-- unpacking -->
                  <StackPanel Spacing="8" Margin="18,12" IsVisible="{Binding IsPreparing}" VerticalAlignment="Center">
                    <TextBlock Text="{Binding PrepareStatus}" HorizontalAlignment="Center" FontSize="13"
                               TextTrimming="CharacterEllipsis" FontFamily="{StaticResource DisplayFont}" />
                    <ProgressBar IsIndeterminate="True" Height="3" MinHeight="3" MaxWidth="320" />
                    <Button Classes="ghost small" Content="{l:Tr 'Cancel'}" HorizontalAlignment="Center"
                            Command="{Binding ClearPlayerSourceCommand}" />
                  </StackPanel>

                  <!-- loaded -->
                  <Grid ColumnDefinitions="Auto,*,Auto,Auto" ColumnSpacing="14" Margin="18,12" IsVisible="{Binding HasDrop}"
                        VerticalAlignment="Center" Background="Transparent" ToolTip.Tip="{l:Tr 'Drop something else here to replace it'}">
                    <Border Width="46" Height="46" CornerRadius="23" Background="{DynamicResource AccentWashBrush}"
                            BorderBrush="{DynamicResource AccentLineBrush}" BorderThickness="1">
                      <Path Data="{StaticResource IconArchive}" Stroke="{DynamicResource AccentBrush}" StrokeThickness="1.6"
                            StrokeJoin="Round" Stretch="Uniform" Width="20" Height="20" />
                    </Border>
                    <StackPanel Grid.Column="1" Spacing="2" VerticalAlignment="Center">
                      <TextBlock Text="{Binding DropTitle}" FontWeight="SemiBold" FontSize="14"
                                 FontFamily="{StaticResource DisplayFont}" TextTrimming="CharacterEllipsis" />
                      <TextBlock Text="{Binding DropSummary}" FontSize="12" Foreground="{DynamicResource Text2Brush}"
                                 FontFamily="{StaticResource MonoFont}" TextWrapping="Wrap" />
                    </StackPanel>
                    <Button Grid.Column="2" Classes="ghost small" Content="{l:Tr 'Change…'}" VerticalAlignment="Center"
                            Command="{Binding BrowseSourceArchiveCommand}" ToolTip.Tip="{l:Tr 'Pick another archive'}" />
                    <Button Grid.Column="3" Classes="icon" VerticalAlignment="Center" Command="{Binding ClearPlayerSourceCommand}"
                            ToolTip.Tip="{l:Tr 'Clear'}">
                      <Path Data="{StaticResource IconClose}" Stroke="{DynamicResource Text3Brush}" StrokeThickness="1.8"
                            Width="10" Height="10" Stretch="Uniform" StrokeLineCap="Round" />
                    </Button>
                  </Grid>
                </Panel>

                <!-- what the drop holds: pick the mod to install -->
                <StackPanel Spacing="6" IsVisible="{Binding HasDetected}">
                  <TextBlock Classes="label" Text="{l:Tr 'FOUND IN IT'}" Margin="0" />
                  <ItemsControl ItemsSource="{Binding Detected}">
                    <ItemsControl.ItemsPanel>
                      <ItemsPanelTemplate>
                        <StackPanel Spacing="6" />
                      </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                      <DataTemplate x:DataType="vm:DetectedModViewModel">
                        <RadioButton Classes="found" GroupName="detected" IsChecked="{Binding IsSelected}"
                                     IsEnabled="{Binding Installable}" ToolTip.Tip="{Binding Detail}">
                          <Grid ColumnDefinitions="Auto,Auto,*,Auto" ColumnSpacing="11">
                            <Panel Width="16" Height="16" VerticalAlignment="Center">
                              <Ellipse Classes="radio-ring" StrokeThickness="1.5" />
                              <Ellipse Classes="radio-dot" Width="8" Height="8" />
                            </Panel>
                            <Border Grid.Column="1" Classes="badge" VerticalAlignment="Center" MinWidth="64">
                              <TextBlock Text="{Binding CategoryName}" HorizontalAlignment="Center" />
                            </Border>
                            <StackPanel Grid.Column="2" Spacing="1" VerticalAlignment="Center">
                              <TextBlock Text="{Binding Title}" FontWeight="SemiBold" FontSize="13" TextTrimming="CharacterEllipsis" />
                              <TextBlock Text="{Binding Detail}" FontSize="11" FontFamily="{StaticResource MonoFont}"
                                         Foreground="{DynamicResource Text3Brush}" TextTrimming="CharacterEllipsis" />
                            </StackPanel>
                            <TextBlock Grid.Column="3" Classes="state" Classes.ready="{Binding Installable}" Text="{Binding State}"
                                       VerticalAlignment="Center" />
                          </Grid>
                        </RadioButton>
                      </DataTemplate>
                    </ItemsControl.ItemTemplate>
                  </ItemsControl>
                </StackPanel>

                <Border Classes="warn" IsVisible="{Binding ShowDropProblem}">
                  <TextBlock Text="{Binding DropError}" TextWrapping="Wrap" FontSize="12" Foreground="{DynamicResource DangerBrush}" />
                </Border>
                <Border Classes="caution" IsVisible="{Binding ShowDropNotice}">
                  <TextBlock Text="{Binding DropError}" TextWrapping="Wrap" FontSize="12" Foreground="{DynamicResource Text1Brush}" />
                </Border>
              </StackPanel>
            </Border>

            <!-- modder: the panel's source, then 02 OUTPUT -->
            <ContentControl Content="{Binding ModderPanel}" IsVisible="{Binding IsModder}">
              <ContentControl.DataTemplates>
                <DataTemplate DataType="vm:WeaponViewModel">
                  <p:WeaponSourceView />
                </DataTemplate>
                <DataTemplate DataType="vm:ModPanelViewModel">
                  <Panel />
                </DataTemplate>
              </ContentControl.DataTemplates>
            </ContentControl>

            <Border Classes="card" IsVisible="{Binding ShowOutputCard}">
              <StackPanel Spacing="10">
                <Grid ColumnDefinitions="Auto,Auto,*,Auto" ColumnSpacing="10">
                  <TextBlock Classes="idx" Text="02" />
                  <TextBlock Grid.Column="1" Classes="h" Text="{l:Tr 'OUTPUT'}" />
                  <TextBlock Grid.Column="2" Classes="desc" VerticalAlignment="Center" TextWrapping="NoWrap"
                             TextTrimming="CharacterEllipsis" Text="{l:Tr 'Where to save the finished Add-On'}" />
                  <Border Grid.Column="3" Classes="seg small">
                    <StackPanel Orientation="Horizontal" Spacing="2">
                      <RadioButton Classes="seg" GroupName="fmt" IsChecked="{Binding PackRpf}" Content="{l:Tr 'Pack · dlc.rpf'}" />
                      <RadioButton Classes="seg" GroupName="fmt" IsChecked="{Binding LooseFolders}" Content="{l:Tr 'Loose folders'}"
                                   ToolTip.Tip="{l:Tr 'Unpacked *.rpf folders, to pack with CodeWalker yourself'}" />
                    </StackPanel>
                  </Border>
                </Grid>
                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                  <TextBox Classes="path" Text="{Binding OutputFolder}" PlaceholderText="{l:Tr 'Output folder'}" />
                  <Button Grid.Column="1" Classes="ghost" Command="{Binding BrowseOutputCommand}">
                    <StackPanel Orientation="Horizontal" Spacing="7">
                      <PathIcon Data="{StaticResource IconFolder}" Width="14" Height="14" />
                      <TextBlock Text="{l:Tr 'Browse…'}" />
                    </StackPanel>
                  </Button>
                </Grid>
              </StackPanel>
            </Border>
          </StackPanel>

          <!-- the active panel's settings; the player's first steps until a mod is picked -->
          <Panel>
          <ContentControl Content="{Binding ActivePanel}" VerticalContentAlignment="Stretch"
                          HorizontalContentAlignment="Stretch">
            <ContentControl.DataTemplates>
              <DataTemplate DataType="vm:WeaponViewModel">
                <p:WeaponFormView />
              </DataTemplate>
              <DataTemplate DataType="vm:ComingSoonViewModel">
                <p:ComingSoonView />
              </DataTemplate>
              <DataTemplate DataType="vm:OivViewModel">
                <p:OivFormView />
              </DataTemplate>
              <DataTemplate DataType="vm:ReplacementViewModel">
                <p:ReplaceFormView />
              </DataTemplate>
              <DataTemplate DataType="vm:ScriptViewModel">
                <p:ScriptFormView />
              </DataTemplate>
              <DataTemplate DataType="vm:AddonViewModel">
                <p:AddonFormView />
              </DataTemplate>
              <DataTemplate DataType="vm:LiveryViewModel">
                <p:LiveryFormView />
              </DataTemplate>
              <DataTemplate DataType="vm:ClothingViewModel">
                <p:ClothingFormView />
              </DataTemplate>
              <DataTemplate DataType="vm:MapViewModel">
                <p:MapFormView />
              </DataTemplate>
            </ContentControl.DataTemplates>
          </ContentControl>
          <Border Classes="card" IsVisible="{Binding ShowSupportedCard}">
            <Grid ColumnDefinitions="*,*,*" ColumnSpacing="14" VerticalAlignment="Center" Margin="4,0">
              <StackPanel Classes="step">
                <TextBlock Classes="step-no" Text="1" />
                <TextBlock Classes="step-title" Text="{l:Tr 'Drop'}" />
                <TextBlock Classes="desc" TextAlignment="Center"
                           Text="{l:Tr 'The mod exactly as you downloaded it. Nested archives are unpacked, readmes skipped.'}" />
              </StackPanel>
              <StackPanel Grid.Column="1" Classes="step">
                <TextBlock Classes="step-no" Text="2" />
                <TextBlock Classes="step-title" Text="{l:Tr 'Check'}" />
                <TextBlock Classes="desc" TextAlignment="Center"
                           Text="{l:Tr 'See what was found, adjust the settings, then read every step the install will take.'}" />
              </StackPanel>
              <StackPanel Grid.Column="2" Classes="step">
                <TextBlock Classes="step-no" Text="3" />
                <TextBlock Classes="step-title" Text="{l:Tr 'Play'}" />
                <TextBlock Classes="desc" TextAlignment="Center"
                           Text="{l:Tr 'Installed through the mods folder — switch it off or remove it any time in the Library.'}" />
              </StackPanel>
            </Grid>
          </Border>
          </Panel>
        </DockPanel>

        <!-- side: the active panel's analysis, or what ModDrop V handles -->
        <ContentControl Grid.Column="1" Content="{Binding ActivePanel}" VerticalContentAlignment="Stretch"
                        HorizontalContentAlignment="Stretch">
          <ContentControl.DataTemplates>
            <DataTemplate DataType="vm:WeaponViewModel">
              <p:WeaponSideView />
            </DataTemplate>
            <DataTemplate DataType="vm:OivViewModel">
              <p:OivSideView />
            </DataTemplate>
            <DataTemplate DataType="vm:ReplacementViewModel">
              <p:ReplaceSideView />
            </DataTemplate>
            <DataTemplate DataType="vm:ScriptViewModel">
              <p:ScriptSideView />
            </DataTemplate>
            <DataTemplate DataType="vm:AddonViewModel">
              <p:AddonSideView />
            </DataTemplate>
            <DataTemplate DataType="vm:LiveryViewModel">
              <p:LiverySideView />
            </DataTemplate>
            <DataTemplate DataType="vm:ClothingViewModel">
              <p:ClothingSideView />
            </DataTemplate>
            <DataTemplate DataType="vm:MapViewModel">
              <p:MapSideView />
            </DataTemplate>
            <DataTemplate DataType="vm:ModPanelViewModel">
              <p:SupportedView DataContext="{Binding Shell}" VerticalAlignment="Top" />
            </DataTemplate>
          </ContentControl.DataTemplates>
        </ContentControl>
        <p:SupportedView Grid.Column="1" VerticalAlignment="Top" IsVisible="{Binding ShowSupportedCard}" />
      </Grid>

      <!-- ================= LIBRARY (player): what is installed | game status ================= -->
      <Grid Grid.Row="2" ColumnDefinitions="*,360" ColumnSpacing="14" Margin="20,12" IsVisible="{Binding ShowLibraryPage}">
        <Border Classes="card" Padding="16,13,6,13">
          <Grid RowDefinitions="Auto,Auto,*,Auto" RowSpacing="10">
            <Grid ColumnDefinitions="Auto,Auto,*,Auto,Auto" ColumnSpacing="10" Margin="0,0,10,0">
              <TextBlock Classes="h" Text="{l:Tr 'INSTALLED MODS'}" />
              <Border Grid.Column="1" Classes="badge" IsVisible="{Binding HasInstalled}" VerticalAlignment="Center">
                <TextBlock Text="{Binding InstalledCount}" />
              </Border>
              <TextBox Grid.Column="3" Classes="search" Width="230" Text="{Binding LibrarySearch}" PlaceholderText="{l:Tr 'Search'}"
                       IsVisible="{Binding HasInstalled}">
                <TextBox.InnerLeftContent>
                  <Path Data="{StaticResource IconSearch}" Stroke="{DynamicResource Text3Brush}" StrokeThickness="1.7"
                        StrokeLineCap="Round" Stretch="Uniform" Width="12" Height="12" Margin="10,0,0,0" />
                </TextBox.InnerLeftContent>
              </TextBox>
              <Button Grid.Column="4" Classes="icon" Command="{Binding RefreshLibraryCommand}" VerticalAlignment="Center"
                      ToolTip.Tip="{l:Tr 'Read the game folder again'}">
                <Path Data="{StaticResource IconRefresh}" Stroke="{DynamicResource Text2Brush}" StrokeThickness="1.7"
                      StrokeLineCap="Round" StrokeJoin="Round" Stretch="Uniform" Width="14" Height="14" />
              </Button>
            </Grid>

            <ItemsControl Grid.Row="1" ItemsSource="{Binding LibraryFilters}" IsVisible="{Binding HasInstalled}" Margin="0,0,10,0">
              <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate>
                  <WrapPanel ItemSpacing="6" LineSpacing="6" />
                </ItemsPanelTemplate>
              </ItemsControl.ItemsPanel>
              <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="vm:LibraryFilterViewModel">
                  <RadioButton Classes="filter" GroupName="libfilter" IsChecked="{Binding IsOn}">
                    <StackPanel Orientation="Horizontal" Spacing="7">
                      <TextBlock Text="{Binding Label}" />
                      <TextBlock Classes="n" Text="{Binding Count}" />
                    </StackPanel>
                  </RadioButton>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
            <TextBlock Grid.Row="1" Classes="desc" Margin="0,0,10,0" IsVisible="{Binding !HasInstalled}"
                       Text="{Binding InstalledEmptyText}" />

            <ScrollViewer Grid.Row="2" IsVisible="{Binding HasInstalled}" Padding="0,0,10,0">
              <StackPanel Spacing="6">
                <TextBlock Classes="desc" IsVisible="{Binding LibraryNoMatch}" Text="{l:Tr 'Nothing installed matches this filter.'}" />
                <ItemsControl ItemsSource="{Binding InstalledView}">
                  <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                      <StackPanel Spacing="6" />
                    </ItemsPanelTemplate>
                  </ItemsControl.ItemsPanel>
                  <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="vm:InstalledModViewModel">
                      <Border Background="{DynamicResource Surface2Brush}" CornerRadius="8" Padding="12,7,6,7"
                              BorderBrush="{DynamicResource BorderBrushSoft}" BorderThickness="1"
                              Classes.removing="{Binding PendingRemove}">
                        <Border.Styles>
                          <Style Selector="Border.removing StackPanel.info">
                            <Setter Property="Opacity" Value="0.5" />
                          </Style>
                          <Style Selector="Border.removing TextBlock.wname">
                            <Setter Property="TextDecorations" Value="Strikethrough" />
                          </Style>
                        </Border.Styles>
                        <Grid ColumnDefinitions="Auto,Auto,*,Auto,Auto,Auto,Auto" ColumnSpacing="10">
                          <CheckBox IsChecked="{Binding Enabled}" IsEnabled="{Binding CanToggle}" VerticalAlignment="Center"
                                    MinWidth="0" Padding="0" ToolTip.Tip="{Binding ToggleTip}"
                                    ToolTip.ShowOnDisabled="True" />
                          <Border Grid.Column="1" Classes="badge" VerticalAlignment="Center" MinWidth="64">
                            <TextBlock Text="{Binding CategoryName}" HorizontalAlignment="Center" />
                          </Border>
                          <StackPanel Grid.Column="2" Classes="info" Spacing="1" VerticalAlignment="Center">
                            <TextBlock Classes="wname" Text="{Binding Name}" FontWeight="SemiBold" FontSize="13"
                                       TextTrimming="CharacterEllipsis" />
                            <TextBlock FontSize="11" Foreground="{DynamicResource Text3Brush}" TextTrimming="CharacterEllipsis"
                                       ToolTip.Tip="{Binding Subline}">
                              <Run Text="{Binding Where}" FontFamily="{StaticResource MonoFont}" /><Run Text="{Binding OriginSuffix}" />
                            </TextBlock>
                          </StackPanel>
                          <StackPanel Grid.Column="3" Orientation="Horizontal" Spacing="4" VerticalAlignment="Center"
                                      IsVisible="{Binding HasConflicts}">
                            <Border Classes="badge conflict" VerticalAlignment="Center" ToolTip.Tip="{Binding ConflictsTip}">
                              <TextBlock Text="{l:Tr 'conflict'}" />
                            </Border>
                            <Button Classes="ghost small" Padding="7,2" MinHeight="22" VerticalAlignment="Center"
                                    Command="{Binding RaiseCommand}" IsVisible="{Binding CanRaise}"
                                    ToolTip.Tip="{l:Tr 'Put this mod’s files on top of the others’ (shows the plan first)'}">
                              <TextBlock Text="{l:Tr 'on top'}" FontSize="11" />
                            </Button>
                          </StackPanel>
                          <Border Grid.Column="4" Classes="badge" VerticalAlignment="Center" IsVisible="{Binding HasStatus}">
                            <TextBlock Text="{Binding Status}" />
                          </Border>
                          <Button Grid.Column="5" Classes="icon" VerticalAlignment="Center" Command="{Binding OpenFolderCommand}"
                                  IsVisible="{Binding CanOpenFolder}" ToolTip.Tip="{l:Tr 'Open its folder'}">
                            <PathIcon Data="{StaticResource IconFolder}" Width="15" Height="15" />
                          </Button>
                          <Button Grid.Column="6" Classes="icon" VerticalAlignment="Center" Command="{Binding ToggleRemoveCommand}"
                                  ToolTip.Tip="{Binding RemoveTip}">
                            <Panel Width="16" Height="16">
                              <Path Data="{StaticResource IconTrash}" Stroke="{DynamicResource Text2Brush}" StrokeThickness="1.6"
                                    StrokeLineCap="Round" StrokeJoin="Round" Stretch="Uniform" IsVisible="{Binding !PendingRemove}" />
                              <Path Data="{StaticResource IconUndo}" Stroke="{DynamicResource AccentBrush}" StrokeThickness="1.8"
                                    StrokeLineCap="Round" StrokeJoin="Round" Stretch="Uniform" IsVisible="{Binding PendingRemove}" />
                            </Panel>
                          </Button>
                        </Grid>
                      </Border>
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>
              </StackPanel>
            </ScrollViewer>

            <!-- marked changes: nothing is touched until they are reviewed and applied -->
            <Border Grid.Row="3" Classes="note" Margin="0,2,10,0" IsVisible="{Binding HasPendingChanges}">
              <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="8">
                <StackPanel VerticalAlignment="Center" Spacing="1">
                  <TextBlock Text="{Binding PendingSummary}" FontWeight="SemiBold" FontSize="12.5" />
                  <TextBlock Classes="desc" FontSize="11" Text="{l:Tr 'Nothing changes in the game until you apply.'}" />
                </StackPanel>
                <Button Grid.Column="1" Classes="ghost small" Content="{l:Tr 'Revert'}" VerticalAlignment="Center"
                        Command="{Binding RevertInstalledCommand}" />
                <Button Grid.Column="2" Classes="primary" Padding="16,7" FontSize="12.5" VerticalAlignment="Center"
                        Command="{Binding ReviewChangesCommand}" ToolTip.Tip="{l:Tr 'See the steps, then apply them'}">
                  <TextBlock Text="{l:Tr 'Apply changes…'}" />
                </Button>
              </Grid>
            </Border>
            <TextBlock Grid.Row="3" Classes="desc" Margin="0,2,10,0" IsVisible="{Binding !HasPendingChanges}"
                       Text="{l:Tr 'Untick to switch a mod off, the bin removes it — the changes are applied together after a look at the plan.'}"
                       />
          </Grid>
        </Border>

        <!-- GAME STATUS -->
        <Border Grid.Column="1" Classes="card" Padding="16,13,6,13">
          <Grid RowDefinitions="Auto,*,Auto" RowSpacing="10">
            <Grid ColumnDefinitions="*,Auto" Margin="0,0,10,0">
              <TextBlock Classes="h" Text="{l:Tr 'GAME STATUS'}" />
              <Button Grid.Column="1" Classes="icon" Command="{Binding RefreshStatusCommand}" VerticalAlignment="Center"
                      ToolTip.Tip="{l:Tr 'Check again'}">
                <Path Data="{StaticResource IconRefresh}" Stroke="{DynamicResource Text2Brush}" StrokeThickness="1.7"
                      StrokeLineCap="Round" StrokeJoin="Round" Stretch="Uniform" Width="14" Height="14" />
              </Button>
            </Grid>
            <ScrollViewer Grid.Row="1" Padding="0,0,10,0">
              <StackPanel Spacing="10">
                <TextBlock Classes="desc" IsVisible="{Binding !HasStatus}"
                           Text="{l:Tr 'Choose the GTA V folder (the chip at the top) to see how it stands.'}" />
                <ItemsControl ItemsSource="{Binding StatusRows}">
                  <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                      <StackPanel Spacing="2" />
                    </ItemsPanelTemplate>
                  </ItemsControl.ItemsPanel>
                  <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="vm:StatusRow">
                      <Grid ColumnDefinitions="Auto,112,*" ColumnSpacing="9" Margin="0,4" Background="Transparent"
                            ToolTip.Tip="{Binding Detail}">
                        <Panel Width="8" Height="8" VerticalAlignment="Center">
                          <Ellipse Fill="{DynamicResource SuccessBrush}" IsVisible="{Binding IsOk}" />
                          <Ellipse Fill="{DynamicResource WarnBrush}" IsVisible="{Binding IsWarning}" />
                          <Ellipse Stroke="{DynamicResource Text3Brush}" StrokeThickness="1.3" IsVisible="{Binding IsInfo}" />
                        </Panel>
                        <TextBlock Grid.Column="1" Classes="kv-key" Text="{Binding Label}" VerticalAlignment="Center" />
                        <TextBlock Grid.Column="2" Classes="kv-val" Classes.warn="{Binding IsWarning}" Text="{Binding Value}"
                                   VerticalAlignment="Center" TextWrapping="Wrap" />
                      </Grid>
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>
                <Border Classes="caution" IsVisible="{Binding HasStaleCopies}">
                  <StackPanel Spacing="8">
                    <TextBlock Text="{Binding StaleCopiesText}" TextWrapping="Wrap" FontSize="12"
                               Foreground="{DynamicResource Text1Brush}" />
                    <Button Classes="ghost small" HorizontalAlignment="Left" Command="{Binding UpdateCopiesCommand}"
                            ToolTip.Tip="{l:Tr 'Fresh copies from the updated game, with every mod’s changes put back'}">
                      <StackPanel Orientation="Horizontal" Spacing="6">
                        <Path Data="{StaticResource IconRefresh}" Stroke="{Binding $parent[Button].Foreground}" StrokeThickness="1.7"
                              StrokeLineCap="Round" StrokeJoin="Round" Stretch="Uniform" Width="11" Height="11" />
                        <TextBlock Text="{l:Tr 'Update copies…'}" />
                      </StackPanel>
                    </Button>
                  </StackPanel>
                </Border>
              </StackPanel>
            </ScrollViewer>
            <TextBlock Grid.Row="2" Classes="hint" Margin="0,0,10,0" Text="{l:Tr 'Hover a line for details.'}" IsVisible="{Binding HasStatus}" />
          </Grid>
        </Border>
      </Grid>

      <!-- ================= FOOTER ================= -->
      <Border Grid.Row="3" Padding="20,10" BorderBrush="{DynamicResource BorderBrushSoft}" BorderThickness="0,1,0,0"
              Background="{DynamicResource Surface1Brush}" IsVisible="{Binding ShowFooter}">
        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="18" MinHeight="44">
          <!-- result banner -->
          <Border x:Name="ResultBanner" IsVisible="{Binding ResultVisible}" CornerRadius="9" Padding="12,7"
                  BorderThickness="1" Classes.ok="{Binding ResultOk}" Classes.err="{Binding !ResultOk}">
            <Border.Styles>
              <Style Selector="Border.ok">
                <Setter Property="Background" Value="{DynamicResource SuccessWashBrush}" />
                <Setter Property="BorderBrush" Value="{DynamicResource SuccessBrush}" />
              </Style>
              <Style Selector="Border.err">
                <Setter Property="Background" Value="{DynamicResource DangerWashBrush}" />
                <Setter Property="BorderBrush" Value="{DynamicResource DangerBrush}" />
              </Style>
            </Border.Styles>
            <Grid ColumnDefinitions="Auto,*,Auto,Auto,Auto" ColumnSpacing="10">
              <Panel Width="20" Height="20" VerticalAlignment="Top" Margin="0,1,0,0">
                <Path Data="{StaticResource IconCheck}" Stroke="{DynamicResource SuccessBrush}" StrokeThickness="2.4"
                      StrokeLineCap="Round" Stretch="Uniform" IsVisible="{Binding ResultOk}" />
                <Path Data="{StaticResource IconAlert}" Stroke="{DynamicResource DangerBrush}" StrokeThickness="2"
                      StrokeLineCap="Round" StrokeJoin="Round" Stretch="Uniform" IsVisible="{Binding !ResultOk}" />
              </Panel>
              <StackPanel Grid.Column="1" Spacing="1">
                <TextBlock Text="{Binding ResultTitle}" FontWeight="SemiBold" FontFamily="{StaticResource DisplayFont}" />
                <TextBlock Text="{Binding ResultDetail}" FontSize="12" Foreground="{DynamicResource Text2Brush}"
                           TextWrapping="Wrap" MaxLines="3" TextTrimming="CharacterEllipsis" />
              </StackPanel>
              <Button Grid.Column="2" Classes="ghost small" Content="{l:Tr 'Show log'}" VerticalAlignment="Center"
                      Command="{Binding OpenLogCommand}" IsVisible="{Binding HasLog}" />
              <Button Grid.Column="3" Classes="ghost small" Content="{l:Tr 'Open folder'}" VerticalAlignment="Center"
                      Command="{Binding OpenResultCommand}" IsVisible="{Binding HasResultPath}" />
              <Button Grid.Column="4" Classes="icon" VerticalAlignment="Top" Command="{Binding DismissResultCommand}">
                <Path Data="{StaticResource IconClose}" Stroke="{DynamicResource Text3Brush}" StrokeThickness="1.8"
                      Width="10" Height="10" Stretch="Uniform" StrokeLineCap="Round" />
              </Button>
            </Grid>
          </Border>

          <Button Grid.Column="1" Classes="primary" Command="{Binding PrimaryCommand}" VerticalAlignment="Center"
                  MinWidth="220" HotKey="Ctrl+Enter" IsVisible="{Binding ShowWorkspace}" IsEnabled="{Binding CanStart}">
            <TextBlock Text="{Binding BuildButtonText}" HorizontalAlignment="Center" />
          </Button>
        </Grid>
      </Border>
    </Grid>

    <!-- ================= GAME DIALOG (player): which GTA V to install into ================= -->
    <Border x:Name="GameScrim" Background="{DynamicResource ScrimBrush}" IsVisible="{Binding IsGameDialogOpen}">
      <Border Classes="card dialog" Width="620" Margin="24" HorizontalAlignment="Center" VerticalAlignment="Center">
        <StackPanel Spacing="12">
          <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="14">
            <Border Width="44" Height="44" CornerRadius="22" Background="{DynamicResource AccentWashBrush}"
                    BorderBrush="{DynamicResource AccentLineBrush}" BorderThickness="1">
              <Path Data="{StaticResource IconGame}" Stroke="{DynamicResource AccentBrush}" StrokeThickness="1.6"
                    StrokeLineCap="Round" StrokeJoin="Round" Stretch="Uniform" Width="24" Height="18" />
            </Border>
            <StackPanel Grid.Column="1" Spacing="2" VerticalAlignment="Center">
              <TextBlock Classes="h" Text="{l:Tr 'YOUR GTA V'}" />
              <TextBlock Classes="desc" Text="{l:Tr 'Mods are installed straight into this game. Choose the folder with GTA5.exe or GTA5_Enhanced.exe.'}" />
            </StackPanel>
            <Button Grid.Column="2" Classes="icon" VerticalAlignment="Top" Command="{Binding CloseGameDialogCommand}"
                    ToolTip.Tip="{l:Tr 'Close'}">
              <Path Data="{StaticResource IconClose}" Stroke="{DynamicResource Text3Brush}" StrokeThickness="1.8"
                    Width="10" Height="10" Stretch="Uniform" StrokeLineCap="Round" />
            </Button>
          </Grid>

          <!-- installs found on this PC -->
          <StackPanel Spacing="8" IsVisible="{Binding IsSearchingGames}" Orientation="Horizontal">
            <ProgressBar IsIndeterminate="True" Width="80" Height="3" MinHeight="3" MinWidth="0" VerticalAlignment="Center" />
            <TextBlock Classes="desc" Text="{l:Tr 'Looking for GTA V on this PC…'}" VerticalAlignment="Center" />
          </StackPanel>
          <StackPanel Spacing="6" IsVisible="{Binding HasGameCandidates}">
            <TextBlock Classes="label" Text="{l:Tr 'FOUND ON THIS PC'}" Margin="0" />
            <ItemsControl ItemsSource="{Binding GameCandidates}">
              <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate>
                  <StackPanel Spacing="6" />
                </ItemsPanelTemplate>
              </ItemsControl.ItemsPanel>
              <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="vm:GameCandidate">
                  <Button Classes="pick" CommandParameter="{Binding}"
                          Command="{Binding $parent[ItemsControl].((vm:MainViewModel)DataContext).UseGameCommand}">
                    <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="12">
                      <Border Classes="badge" VerticalAlignment="Center" MinWidth="118">
                        <TextBlock Text="{Binding EditionName}" HorizontalAlignment="Center" />
                      </Border>
                      <TextBlock Grid.Column="1" Text="{Binding Path}" FontFamily="{StaticResource MonoFont}" FontSize="12"
                                 VerticalAlignment="Center" TextTrimming="LeadingCharacterEllipsis" />
                      <TextBlock Grid.Column="2" Text="{l:Tr 'Use'}" FontSize="12" Foreground="{DynamicResource AccentBrush}"
                                 VerticalAlignment="Center" />
                    </Grid>
                  </Button>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </StackPanel>

          <StackPanel>
            <TextBlock Classes="label" Text="{l:Tr 'GAME FOLDER'}" />
            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
              <TextBox Classes="path" Text="{Binding GameFolder}" PlaceholderText="{l:Tr 'GTA V game folder'}" />
              <Button Grid.Column="1" Classes="ghost" Command="{Binding BrowseGameCommand}">
                <StackPanel Orientation="Horizontal" Spacing="7">
                  <PathIcon Data="{StaticResource IconFolder}" Width="14" Height="14" />
                  <TextBlock Text="{l:Tr 'Browse…'}" />
                </StackPanel>
              </Button>
            </Grid>
            <TextBlock Classes="hint" Text="{Binding GameEditionHint}" IsVisible="{Binding HasGameEditionHint}" />
          </StackPanel>

          <!-- detected from the executable; only a folder with both needs a choice -->
          <StackPanel Orientation="Horizontal" Spacing="10">
            <TextBlock Classes="desc" Text="{l:Tr 'Game version'}" VerticalAlignment="Center" />
            <Border Classes="seg">
              <StackPanel Orientation="Horizontal" Spacing="2">
                <RadioButton Classes="seg" GroupName="edition-game" IsChecked="{Binding IsLegacy}" Content="Legacy" />
                <RadioButton Classes="seg" GroupName="edition-game" IsChecked="{Binding IsEnhanced}" Content="Enhanced" />
              </StackPanel>
            </Border>
          </StackPanel>

          <TextBlock Classes="hint" Margin="0">
            <Run Text="{l:Tr 'Everything goes into the game’s mods folder — the original files stay untouched. A game without mod support gets it set up: RageOpenV.asi + ASI loader, the mods folder and a copy of update.rpf.'}" />
          </TextBlock>

          <Button Classes="primary" HorizontalAlignment="Right" MinWidth="140" Padding="22,9"
                  Command="{Binding CloseGameDialogCommand}" IsEnabled="{Binding HasGame}">
            <TextBlock Text="{l:Tr 'Done'}" HorizontalAlignment="Center" />
          </Button>
        </StackPanel>
      </Border>
    </Border>

    <!-- ================= PLAN: what will be done ================= -->
    <Border x:Name="PlanScrim" Background="{DynamicResource ScrimBrush}" IsVisible="{Binding IsPlanOpen}">
      <Border Classes="card dialog" Width="660" Margin="24" HorizontalAlignment="Center" VerticalAlignment="Center">
        <StackPanel Spacing="14">
          <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="14">
            <Border Width="44" Height="44" CornerRadius="22" Background="{DynamicResource AccentWashBrush}"
                    BorderBrush="{DynamicResource AccentLineBrush}" BorderThickness="1">
              <Path Data="{StaticResource IconSteps}" Stroke="{DynamicResource AccentBrush}" StrokeThickness="1.7"
                    StrokeLineCap="Round" StrokeJoin="Round" Stretch="Uniform" Width="20" Height="18" />
            </Border>
            <StackPanel Grid.Column="1" Spacing="2" VerticalAlignment="Center">
              <TextBlock Classes="h" Text="{l:Tr 'WHAT WILL BE DONE'}" />
              <TextBlock Text="{Binding PlanTitle}" FontFamily="{StaticResource DisplayFont}" FontSize="15" FontWeight="SemiBold"
                         TextTrimming="CharacterEllipsis" />
            </StackPanel>
            <Button Grid.Column="2" Classes="icon" VerticalAlignment="Top" Command="{Binding ClosePlanCommand}"
                    ToolTip.Tip="{l:Tr 'Close'}">
              <Path Data="{StaticResource IconClose}" Stroke="{DynamicResource Text3Brush}" StrokeThickness="1.8"
                    Width="10" Height="10" Stretch="Uniform" StrokeLineCap="Round" />
            </Button>
          </Grid>

          <Border Background="{DynamicResource InputBrush}" CornerRadius="8" Padding="12,8"
                  BorderBrush="{DynamicResource BorderBrushNormal}" BorderThickness="1">
            <Grid ColumnDefinitions="Auto,*" ColumnSpacing="10">
              <Path Data="{StaticResource IconGame}" Stroke="{DynamicResource AccentBrush}" StrokeThickness="1.6"
                    StrokeLineCap="Round" StrokeJoin="Round" Stretch="Uniform" Width="20" Height="14" VerticalAlignment="Center" />
              <TextBlock Grid.Column="1" Text="{Binding PlanTarget}" FontFamily="{StaticResource MonoFont}" FontSize="12"
                         VerticalAlignment="Center" TextTrimming="LeadingCharacterEllipsis" />
            </Grid>
          </Border>

          <ScrollViewer MaxHeight="300" Padding="0,0,8,0">
            <ItemsControl ItemsSource="{Binding PlanSteps}">
              <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate>
                  <StackPanel Spacing="8" />
                </ItemsPanelTemplate>
              </ItemsControl.ItemsPanel>
              <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="vm:PlanStepRow">
                  <Grid ColumnDefinitions="Auto,*" ColumnSpacing="12">
                    <Border Width="24" Height="24" CornerRadius="12" VerticalAlignment="Top"
                            Background="{DynamicResource AccentWashBrush}" BorderBrush="{DynamicResource AccentLineBrush}" BorderThickness="1">
                      <TextBlock Text="{Binding Number}" FontFamily="{StaticResource MonoFont}" FontSize="11.5"
                                 Foreground="{DynamicResource AccentBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <TextBlock Grid.Column="1" Text="{Binding Text}" TextWrapping="Wrap" FontSize="13" VerticalAlignment="Center"
                               LineHeight="19" />
                  </Grid>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </ScrollViewer>

          <ItemsControl ItemsSource="{Binding PlanWarnings}" IsVisible="{Binding HasPlanWarnings}">
            <ItemsControl.ItemsPanel>
              <ItemsPanelTemplate>
                <StackPanel Spacing="6" />
              </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
              <DataTemplate x:DataType="x:String">
                <Border Classes="caution">
                  <TextBlock Text="{Binding}" TextWrapping="Wrap" FontSize="12" />
                </Border>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>

          <!-- what a big plan takes: archive copies in mods can be gigabytes -->
          <Border Classes="note" IsVisible="{Binding HasPlanFootprint}">
            <StackPanel Spacing="3">
              <TextBlock Text="{Binding PlanFootprint}" TextWrapping="Wrap" FontSize="12" Foreground="{DynamicResource Text2Brush}" />
              <TextBlock Text="{Binding PlanSpace}" TextWrapping="Wrap" FontSize="12" FontWeight="SemiBold"
                         Foreground="{DynamicResource Text1Brush}" IsVisible="{Binding !PlanTooBig}" />
            </StackPanel>
          </Border>
          <Border Classes="caution" IsVisible="{Binding PlanTooBig}">
            <TextBlock Text="{Binding PlanSpace}" TextWrapping="Wrap" FontSize="12" />
          </Border>

          <TextBlock Classes="hint" Margin="0" Text="{Binding PlanNote}" />

          <StackPanel Orientation="Horizontal" Spacing="10" HorizontalAlignment="Right">
            <Button Classes="ghost" Content="{l:Tr 'Cancel'}" MinWidth="110" Command="{Binding ClosePlanCommand}" />
            <Button Classes="primary" MinWidth="160" Padding="22,9" Command="{Binding ConfirmPlanCommand}">
              <TextBlock Text="{Binding PlanConfirmText}" HorizontalAlignment="Center" />
            </Button>
          </StackPanel>
        </StackPanel>
      </Border>
    </Border>

    <!-- ================= 3D PREVIEW (the weapon panel's) ================= -->
    <Border x:Name="PreviewScrim" Background="{DynamicResource ScrimBrush}" IsVisible="{Binding Weapon.IsPreviewOpen}">
      <Border Classes="card dialog" Padding="0" Margin="40,30" MaxWidth="1280" DataContext="{Binding Weapon}"
              x:DataType="vm:WeaponViewModel">
        <Grid RowDefinitions="Auto,*">
          <Grid ColumnDefinitions="Auto,*,Auto,Auto,Auto,Auto" Margin="20,14,12,12" ColumnSpacing="12">
            <Border Width="38" Height="38" CornerRadius="19" Background="{DynamicResource AccentWashBrush}"
                    BorderBrush="{DynamicResource AccentLineBrush}" BorderThickness="1">
              <Path Data="{StaticResource IconCube}" Stroke="{DynamicResource AccentBrush}" StrokeThickness="1.6"
                    StrokeLineCap="Round" StrokeJoin="Round" Stretch="Uniform" Width="18" Height="18" />
            </Border>
            <StackPanel Grid.Column="1" Spacing="2" VerticalAlignment="Center">
              <StackPanel Orientation="Horizontal" Spacing="10">
                <TextBlock Classes="h" Text="{l:Tr '3D PREVIEW'}" VerticalAlignment="Center" />
                <TextBlock Text="{Binding PreviewTitle}" FontFamily="{StaticResource MonoFont}" FontSize="12.5"
                           Foreground="{DynamicResource AccentBrush}" VerticalAlignment="Center" />
              </StackPanel>
              <TextBlock Classes="desc" Text="{Binding PreviewStats}" FontSize="11.5" TextWrapping="NoWrap"
                         TextTrimming="CharacterEllipsis" />
            </StackPanel>
            <CheckBox Grid.Column="2" IsChecked="{Binding PreviewTextured}" VerticalAlignment="Center"
                      ToolTip.Tip="{l:Tr 'Off: a plain material, to judge the shape'}">
              <TextBlock Text="{l:Tr 'Textures'}" FontSize="12.5" />
            </CheckBox>
            <CheckBox Grid.Column="3" IsChecked="{Binding PreviewAutoRotate}" VerticalAlignment="Center"
                      ToolTip.Tip="{l:Tr 'Keep the model turning'}">
              <TextBlock Text="{l:Tr 'Turntable'}" FontSize="12.5" />
            </CheckBox>
            <Button Grid.Column="4" Classes="ghost small" VerticalAlignment="Center" Command="{Binding ResetPreviewViewCommand}"
                    ToolTip.Tip="{l:Tr 'Frame the model again (or double-click it)'}">
              <StackPanel Orientation="Horizontal" Spacing="6">
                <Path Data="{StaticResource IconReset}" Stroke="{Binding $parent[Button].Foreground}" StrokeThickness="1.7"
                      StrokeLineCap="Round" StrokeJoin="Round" Stretch="Uniform" Width="11" Height="11" />
                <TextBlock Text="{l:Tr 'Reset view'}" />
              </StackPanel>
            </Button>
            <Button Grid.Column="5" Classes="icon" VerticalAlignment="Center" Command="{Binding ClosePreviewCommand}"
                    ToolTip.Tip="{l:Tr 'Close'}">
              <Path Data="{StaticResource IconClose}" Stroke="{DynamicResource Text3Brush}" StrokeThickness="1.8"
                    Width="10" Height="10" Stretch="Uniform" StrokeLineCap="Round" />
            </Button>
          </Grid>

          <Grid Grid.Row="1" ColumnDefinitions="*,290" ColumnSpacing="14" Margin="16,0,16,16">
            <Border CornerRadius="10" ClipToBounds="True" BorderBrush="{DynamicResource BorderBrushNormal}" BorderThickness="1">
              <Panel>
                <c:WeaponModelView x:Name="PreviewView" Model="{Binding PreviewModel}" VisiblePieces="{Binding PreviewVisible}"
                                   Textured="{Binding PreviewTextured}" Tint="{Binding PreviewTint}"
                                   AutoRotate="{Binding PreviewSpinning}" ResetCount="{Binding PreviewResetCount}" />
                <Border HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="10" Padding="12,5" CornerRadius="14"
                        Background="{DynamicResource ScrimBrush}" IsHitTestVisible="False">
                  <TextBlock FontSize="11.5" Foreground="#E6EEF2F7" TextWrapping="Wrap" TextAlignment="Center"
                             Text="{l:Tr 'Drag — turn  ·  wheel — zoom  ·  right-drag or Shift+drag — move  ·  double-click — frame'}" />
                </Border>
              </Panel>
            </Border>

            <Grid Grid.Column="1" RowDefinitions="Auto,Auto,*,Auto" RowSpacing="8">
              <!-- tints: the rows of the weapon's tint palette, as the game's tint index picks them -->
              <StackPanel Spacing="6" Margin="0,0,0,10" IsVisible="{Binding HasPreviewTints}">
                <Grid ColumnDefinitions="Auto,*" ColumnSpacing="10">
                  <TextBlock Classes="label" Text="{l:Tr 'TINTS'}" Margin="0" VerticalAlignment="Center" />
                  <TextBlock Grid.Column="1" Text="{Binding PreviewTintLabel}" FontSize="12" HorizontalAlignment="Right"
                             VerticalAlignment="Center" Foreground="{DynamicResource AccentBrush}" TextTrimming="CharacterEllipsis" />
                </Grid>
                <TextBlock Classes="desc" FontSize="11.5" TextWrapping="Wrap"
                           Text="{l:Tr 'The colours the weapon’s tint palette gives it — pick one to see it on the model.'}" />
                <ItemsControl ItemsSource="{Binding PreviewTints}" Margin="-3,0,0,0">
                  <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                      <WrapPanel />
                    </ItemsPanelTemplate>
                  </ItemsControl.ItemsPanel>
                  <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="vm:PreviewTintViewModel">
                      <RadioButton Classes="swatch" IsChecked="{Binding IsOn}" ToolTip.Tip="{Binding Label}">
                        <Ellipse Width="20" Height="20" Fill="{Binding Swatch}" StrokeThickness="1"
                                 Stroke="{DynamicResource BorderBrushStrong}" />
                      </RadioButton>
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>
              </StackPanel>

              <StackPanel Grid.Row="1" Spacing="2">
                <TextBlock Classes="label" Text="{l:Tr 'PARTS'}" Margin="0" />
                <TextBlock Classes="desc" FontSize="11.5"
                           Text="{l:Tr 'Components hang on the weapon’s attach bones — one per bone, as in the game.'}" />
              </StackPanel>
              <ScrollViewer Grid.Row="2" Padding="0,0,8,0">
                <ItemsControl ItemsSource="{Binding PreviewPieces}">
                  <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                      <StackPanel Spacing="6" />
                    </ItemsPanelTemplate>
                  </ItemsControl.ItemsPanel>
                  <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="vm:PreviewPieceViewModel">
                      <Border Background="{DynamicResource Surface2Brush}" CornerRadius="8" Padding="10,6"
                              BorderBrush="{DynamicResource BorderBrushSoft}" BorderThickness="1">
                        <Grid ColumnDefinitions="Auto,Auto,*" ColumnSpacing="9">
                          <CheckBox IsChecked="{Binding IsOn}" VerticalAlignment="Center" MinWidth="0" Padding="0" />
                          <Border Grid.Column="1" Classes="badge" VerticalAlignment="Center" MinWidth="54">
                            <TextBlock Text="{Binding Kind}" HorizontalAlignment="Center" />
                          </Border>
                          <StackPanel Grid.Column="2" Spacing="1" VerticalAlignment="Center">
                            <TextBlock Text="{Binding Label}" FontSize="12.5" TextTrimming="CharacterEllipsis"
                                       ToolTip.Tip="{Binding Label}" />
                            <TextBlock Text="{Binding Where}" FontSize="10.5" FontFamily="{StaticResource MonoFont}"
                                       Foreground="{DynamicResource Text3Brush}" TextTrimming="CharacterEllipsis" />
                          </StackPanel>
                        </Grid>
                      </Border>
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>
              </ScrollViewer>
              <ItemsControl Grid.Row="3" ItemsSource="{Binding PreviewWarnings}">
                <ItemsControl.ItemTemplate>
                  <DataTemplate x:DataType="x:String">
                    <Border Classes="warn">
                      <TextBlock Text="{Binding}" TextWrapping="Wrap" FontSize="11" Foreground="{DynamicResource DangerBrush}" />
                    </Border>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
            </Grid>
          </Grid>
        </Grid>
      </Border>
    </Border>

    <!-- ================= 3D PREVIEW (the add-on vehicle / ped panel's, the livery panel's) ================= -->
    <Border Background="{DynamicResource ScrimBrush}" IsVisible="{Binding OpenModelPreview, Converter={x:Static ObjectConverters.IsNotNull}}">
      <Border Classes="card dialog" Padding="0" Margin="40,30" MaxWidth="1280" DataContext="{Binding OpenModelPreview}"
              x:DataType="vm:ModelPreview">
        <Grid RowDefinitions="Auto,*">
          <Grid ColumnDefinitions="Auto,*,Auto,Auto,Auto,Auto" Margin="20,14,12,12" ColumnSpacing="12">
            <Border Width="38" Height="38" CornerRadius="19" Background="{DynamicResource AccentWashBrush}"
                    BorderBrush="{DynamicResource AccentLineBrush}" BorderThickness="1">
              <Path Data="{StaticResource IconCube}" Stroke="{DynamicResource AccentBrush}" StrokeThickness="1.6"
                    StrokeLineCap="Round" StrokeJoin="Round" Stretch="Uniform" Width="18" Height="18" />
            </Border>
            <StackPanel Grid.Column="1" Spacing="2" VerticalAlignment="Center">
              <StackPanel Orientation="Horizontal" Spacing="10">
                <TextBlock Classes="h" Text="{l:Tr '3D PREVIEW'}" VerticalAlignment="Center" />
                <TextBlock Text="{Binding Title}" FontFamily="{StaticResource MonoFont}" FontSize="12.5"
                           Foreground="{DynamicResource AccentBrush}" VerticalAlignment="Center" />
              </StackPanel>
              <TextBlock Classes="desc" Text="{Binding Stats}" FontSize="11.5" TextWrapping="NoWrap"
                         TextTrimming="CharacterEllipsis" />
            </StackPanel>
            <CheckBox Grid.Column="2" IsChecked="{Binding Textured}" VerticalAlignment="Center"
                      ToolTip.Tip="{l:Tr 'Off: a plain material, to judge the shape'}">
              <TextBlock Text="{l:Tr 'Textures'}" FontSize="12.5" />
            </CheckBox>
            <CheckBox Grid.Column="3" IsChecked="{Binding AutoRotate}" VerticalAlignment="Center"
                      ToolTip.Tip="{l:Tr 'Keep the model turning'}">
              <TextBlock Text="{l:Tr 'Turntable'}" FontSize="12.5" />
            </CheckBox>
            <Button Grid.Column="4" Classes="ghost small" VerticalAlignment="Center" Command="{Binding ResetViewCommand}"
                    ToolTip.Tip="{l:Tr 'Frame the model again (or double-click it)'}">
              <StackPanel Orientation="Horizontal" Spacing="6">
                <Path Data="{StaticResource IconReset}" Stroke="{Binding $parent[Button].Foreground}" StrokeThickness="1.7"
                      StrokeLineCap="Round" StrokeJoin="Round" Stretch="Uniform" Width="11" Height="11" />
                <TextBlock Text="{l:Tr 'Reset view'}" />
              </StackPanel>
            </Button>
            <Button Grid.Column="5" Classes="icon" VerticalAlignment="Center" Command="{Binding CloseCommand}"
                    ToolTip.Tip="{l:Tr 'Close'}">
              <Path Data="{StaticResource IconClose}" Stroke="{DynamicResource Text3Brush}" StrokeThickness="1.8"
                    Width="10" Height="10" Stretch="Uniform" StrokeLineCap="Round" />
            </Button>
          </Grid>

          <Grid Grid.Row="1" ColumnDefinitions="*,290" ColumnSpacing="14" Margin="16,0,16,16">
            <Border CornerRadius="10" ClipToBounds="True" BorderBrush="{DynamicResource BorderBrushNormal}" BorderThickness="1">
              <Panel>
                <c:WeaponModelView Model="{Binding Model}" VisiblePieces="{Binding Visible}" Textured="{Binding Textured}"
                                   AutoRotate="{Binding Spinning}" ResetCount="{Binding ResetCount}" />
                <Border HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="10" Padding="12,5" CornerRadius="14"
                        Background="{DynamicResource ScrimBrush}" IsHitTestVisible="False">
                  <TextBlock FontSize="11.5" Foreground="#E6EEF2F7" TextWrapping="Wrap" TextAlignment="Center"
                             Text="{l:Tr 'Drag — turn  ·  wheel — zoom  ·  right-drag or Shift+drag — move  ·  double-click — frame'}" />
                </Border>
              </Panel>
            </Border>

            <Grid Grid.Column="1" RowDefinitions="Auto,*,Auto" RowSpacing="8">
              <StackPanel Spacing="2">
                <TextBlock Classes="label" Text="{l:Tr 'PARTS'}" Margin="0" />
                <TextBlock Classes="desc" FontSize="11.5" TextWrapping="Wrap"
                           Text="{Binding PartsHint}" />
              </StackPanel>
              <ScrollViewer Grid.Row="1" Padding="0,0,8,0">
                <ItemsControl ItemsSource="{Binding Pieces}">
                  <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                      <StackPanel Spacing="6" />
                    </ItemsPanelTemplate>
                  </ItemsControl.ItemsPanel>
                  <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="vm:PreviewPieceViewModel">
                      <Border Background="{DynamicResource Surface2Brush}" CornerRadius="8" Padding="10,6"
                              BorderBrush="{DynamicResource BorderBrushSoft}" BorderThickness="1">
                        <Grid ColumnDefinitions="Auto,Auto,*" ColumnSpacing="9">
                          <CheckBox IsChecked="{Binding IsOn}" VerticalAlignment="Center" MinWidth="0" Padding="0" />
                          <Border Grid.Column="1" Classes="badge" VerticalAlignment="Center" MinWidth="54">
                            <TextBlock Text="{Binding Kind}" HorizontalAlignment="Center" />
                          </Border>
                          <StackPanel Grid.Column="2" Spacing="1" VerticalAlignment="Center">
                            <TextBlock Text="{Binding Label}" FontSize="12.5" TextTrimming="CharacterEllipsis"
                                       ToolTip.Tip="{Binding Label}" />
                            <TextBlock Text="{Binding Where}" FontSize="10.5" FontFamily="{StaticResource MonoFont}"
                                       Foreground="{DynamicResource Text3Brush}" TextTrimming="CharacterEllipsis" />
                          </StackPanel>
                        </Grid>
                      </Border>
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>
              </ScrollViewer>
              <ItemsControl Grid.Row="2" ItemsSource="{Binding Warnings}">
                <ItemsControl.ItemTemplate>
                  <DataTemplate x:DataType="x:String">
                    <Border Classes="caution">
                      <TextBlock Text="{Binding}" TextWrapping="Wrap" FontSize="11" Foreground="{DynamicResource Text1Brush}" />
                    </Border>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
            </Grid>
          </Grid>
        </Grid>
      </Border>
    </Border>

    <!-- ================= LOG DIALOG ================= -->
    <Border x:Name="LogScrim" Background="{DynamicResource ScrimBrush}" IsVisible="{Binding IsLogOpen}">
      <Border Classes="card dialog" Padding="0" Margin="56,40" MaxWidth="920">
        <Grid RowDefinitions="Auto,*">
          <Grid ColumnDefinitions="Auto,*,Auto,Auto,Auto" Margin="20,14,12,10" ColumnSpacing="8">
            <Panel VerticalAlignment="Center">
              <Ellipse Width="7" Height="7" Fill="{DynamicResource AccentBrush}" IsVisible="{Binding !LogIsError}" />
              <Ellipse Width="7" Height="7" Fill="{DynamicResource DangerBrush}" IsVisible="{Binding LogIsError}" />
            </Panel>
            <TextBlock Grid.Column="1" Classes="h" Text="{l:Tr 'LOG'}" Margin="4,0,0,0" />
            <Button Grid.Column="2" Classes="ghost small" Content="{l:Tr 'Log file'}" Command="{Binding OpenLogFolderCommand}"
                    ToolTip.Tip="{l:Tr 'Open the folder with moddropv.log'}" />
            <Button Grid.Column="3" Classes="ghost small" Content="{Binding CopyLogLabel}" Command="{Binding CopyLogCommand}"
                    IsEnabled="{Binding HasLog}" />
            <Button Grid.Column="4" Classes="icon" VerticalAlignment="Center" Command="{Binding CloseLogCommand}"
                    ToolTip.Tip="{l:Tr 'Close'}">
              <Path Data="{StaticResource IconClose}" Stroke="{DynamicResource Text3Brush}" StrokeThickness="1.8"
                    Width="10" Height="10" Stretch="Uniform" StrokeLineCap="Round" />
            </Button>
          </Grid>
          <ScrollViewer Grid.Row="1" x:Name="LogScroll" Padding="20,0,16,16">
            <Panel>
              <TextBlock Classes="desc" IsVisible="{Binding !HasLog}"
                         Text="{l:Tr 'Nothing built or installed yet — the log of the next build or install appears here.'}" />
              <SelectableTextBlock Classes="log" Text="{Binding LogText}" IsVisible="{Binding HasLog}" />
            </Panel>
          </ScrollViewer>
        </Grid>
      </Border>
    </Border>

    <!-- ================= WORK STAGE (a drop falling into the pool) ================= -->
    <Border Background="{DynamicResource StageBrush}" IsVisible="{Binding IsBuilding}">
      <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="6">
        <c:DropStageView Width="420" Height="292" Running="{Binding IsBuilding}" PulseCount="{Binding FireCount}" />
        <TextBlock Text="{Binding StageStatus}" HorizontalAlignment="Center" FontSize="20" FontWeight="SemiBold"
                   FontFamily="{StaticResource DisplayFont}" LetterSpacing="1" />
        <TextBlock Text="{Binding StageHint}" HorizontalAlignment="Center" FontSize="13"
                   Foreground="{DynamicResource AccentBrush}" FontFamily="{StaticResource DisplayFont}" LetterSpacing="1.5" />
        <!-- a plan's steps as they go, and the way out: stopping takes back everything done so far -->
        <StackPanel Spacing="8" Width="420" Margin="0,8,0,0" IsVisible="{Binding HasStageSteps}">
          <ProgressBar Minimum="0" Maximum="{Binding StageSteps}" Value="{Binding StageStep}" Height="4" MinHeight="4" />
          <TextBlock Text="{Binding StageStepText}" HorizontalAlignment="Center" FontSize="11.5" TextAlignment="Center"
                     TextWrapping="Wrap" MaxLines="2" TextTrimming="CharacterEllipsis" Foreground="{DynamicResource Text3Brush}" />
          <Button Classes="ghost small" HorizontalAlignment="Center" Command="{Binding CancelRunCommand}"
                  IsVisible="{Binding CanCancelRun}"
                  ToolTip.Tip="{l:Tr 'Stop after the step that is running — everything done so far is taken back and the game is as it was'}">
            <TextBlock Text="{Binding CancelRunText}" />
          </Button>
        </StackPanel>
      </StackPanel>
    </Border>
  </Grid>
</Window>
